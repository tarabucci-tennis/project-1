<% content_for :title, "#{@user.name} · Court Report" %>

<div class="cr-team-page">

  <%= link_to "← Back", :back, class: "cr-back-link" %>

  <%# ── Player Profile card (TennisRecord-style, clean light card) ── %>
  <%
    gender  = @teams.map { |t| t.gender.presence }.compact.first
    section = @teams.map { |t| t.section.presence }.compact.first
    dyn     = @user.court_report_rating || @user.dynamic_rating
    meter   = rating_meter_data(ntrp: @user.ntrp_rating, dynamic: dyn)
  %>
  <div class="cr-pp">
    <div class="cr-pp-head">
      <span class="cr-pp-head-title">Player Profile</span>
      <%= link_to "View Advanced Player Stats →", tennis_record_url(@user.name),
            target: "_blank", rel: "noopener", class: "cr-pp-head-link" %>
    </div>

    <div class="cr-pp-body">
      <div class="cr-pp-left">
        <div class="cr-pp-row">
          <div>
            <div class="cr-pp-name">
              <%= @user.name %><% if @user.location.present? %> <span class="cr-pp-loc">(<%= @user.location %>)</span><% end %>
              <% if @is_self %><span class="cr-pp-you">(you)</span><% end %>
            </div>
            <div class="cr-pp-sub"><%= [ gender, section ].compact.join(" · ").presence || "USTA" %></div>
          </div>
          <div class="cr-pp-metric">
            <div class="cr-pp-metric-val"><%= @user.ntrp_rating.present? ? @user.ntrp_rating : "—" %></div>
            <div class="cr-pp-metric-cap">
              NTRP<% if @user.ntrp_rating_date.present? %><br><%= @user.ntrp_rating_date.strftime("%-m/%-d/%Y") %><% end %>
            </div>
          </div>
        </div>

        <div class="cr-pp-row">
          <div class="cr-pp-label">Court Report Rating <span class="cr-pp-live">live</span></div>
          <div class="cr-pp-metric">
            <div class="cr-pp-metric-val cr-pp-gold">
              <%= @user.court_report_rating.present? ? sprintf("%.2f", @user.court_report_rating) : "—" %>
            </div>
            <div class="cr-pp-metric-cap">
              <% if @user.court_report_rating.present? %>from <%= @user.court_report_rating_lines %> lines<% else %>no scores yet<% end %>
            </div>
          </div>
        </div>

        <div class="cr-pp-row">
          <div class="cr-pp-label">TennisRecord Dynamic</div>
          <div class="cr-pp-metric">
            <div class="cr-pp-metric-val"><%= @user.dynamic_rating.present? ? sprintf("%.4f", @user.dynamic_rating) : "—" %></div>
            <div class="cr-pp-metric-cap">
              <% if @user.dynamic_rating_date.present? %><%= @user.dynamic_rating_date.strftime("%-m/%-d/%Y") %><% else %>——<% end %>
            </div>
          </div>
        </div>
      </div>

      <div class="cr-pp-right">
        <% if meter %>
          <div class="cr-pp-meter-title"><%= meter[:title] %></div>
          <svg viewBox="0 0 260 150" class="cr-pp-meter" role="img" aria-label="Rating meter">
            <path d="M26,130 A104,104 0 0 1 45.86,68.87" fill="none" stroke="#dc2626" stroke-width="20" stroke-linecap="butt"/>
            <path d="M45.86,68.87 A104,104 0 0 1 97.86,31.09" fill="none" stroke="#f97316" stroke-width="20"/>
            <path d="M97.86,31.09 A104,104 0 0 1 162.14,31.09" fill="none" stroke="#eab308" stroke-width="20"/>
            <path d="M162.14,31.09 A104,104 0 0 1 214.14,68.87" fill="none" stroke="#84cc16" stroke-width="20"/>
            <path d="M214.14,68.87 A104,104 0 0 1 234,130" fill="none" stroke="#16a34a" stroke-width="20" stroke-linecap="butt"/>
            <line x1="130" y1="130" x2="<%= meter[:needle_x] %>" y2="<%= meter[:needle_y] %>"
                  stroke="#0a1628" stroke-width="4" stroke-linecap="round"/>
            <circle cx="130" cy="130" r="8" fill="#0a1628"/>
          </svg>
          <div class="cr-pp-meter-scale"><span>Low</span><span>Average</span><span>High</span></div>
          <div class="cr-pp-meter-band"><%= meter[:band_label] %></div>
        <% end %>
        <div class="cr-pp-links">
          <%= link_to "Recent Match History", tennis_record_match_history_url(@user.name),
                target: "_blank", rel: "noopener", class: "cr-pp-link" %>
          <a href="#cr-advanced-stats" class="cr-pp-link">Advanced Stats ↓</a>
        </div>
      </div>
    </div>
  </div>

  <%# ── Lineup Quick Facts — at-a-glance info captains need when setting a lineup ── %>
  <% if @playing_stats.present? %>
    <section class="cr-section cr-lineup-facts">
      <h2 class="cr-section-title">Lineup Quick Facts</h2>
      <div class="cr-lineup-facts-grid">
        <div class="cr-lineup-fact">
          <div class="cr-lineup-fact-label">Matches Played</div>
          <div class="cr-lineup-fact-value">
            <%= @playing_stats[:matches_played_total] %>
          </div>
        </div>

        <div class="cr-lineup-fact">
          <div class="cr-lineup-fact-label">Plays Singles?</div>
          <div class="cr-lineup-fact-value">
            <% if @playing_stats[:singles][:total] > 0 %>
              Yes · <%= @playing_stats[:singles][:total] %> match<%= @playing_stats[:singles][:total] == 1 ? "" : "es" %>
            <% else %>
              Not yet
            <% end %>
          </div>
        </div>

        <div class="cr-lineup-fact">
          <div class="cr-lineup-fact-label">Usual Doubles Line</div>
          <div class="cr-lineup-fact-value">
            <%= @playing_stats[:usual_doubles_line] || "—" %>
          </div>
        </div>

        <div class="cr-lineup-fact">
          <div class="cr-lineup-fact-label">Best Partner</div>
          <div class="cr-lineup-fact-value">
            <% if @playing_stats[:best_partner] %>
              <%= @playing_stats[:best_partner][:name] %>
              <span style="color: var(--cr-text-muted); font-weight: 500; font-size: 0.85rem;">(<%= @playing_stats[:best_partner][:pct] %>%)</span>
            <% else %>
              —
            <% end %>
          </div>
        </div>
      </div>

      <% if @playing_stats[:matches_played_by_team].any? %>
        <div class="cr-lineup-fact-breakdown">
          <strong>Matches by team:</strong>
          <% @playing_stats[:matches_played_by_team].each_with_index do |t, i| %>
            <%= t[:team_name] %> (<%= t[:count] %>)<%= "," unless i == @playing_stats[:matches_played_by_team].size - 1 %>
          <% end %>
        </div>
      <% end %>

      <% if @playing_stats[:is_empty] %>
        <p style="text-align: center; padding: 10px; color: var(--cr-text-muted); font-size: 0.82rem; font-style: italic;">
          Stats will fill in here as match results are entered.
        </p>
      <% end %>
    </section>
  <% end %>

  <%# ── Playing Stats ── %>
  <% if @playing_stats.present? && !@playing_stats[:is_empty] %>
    <section class="cr-section">
      <h2 class="cr-section-title">Playing Stats</h2>

      <%# Overall stats row %>
      <div class="cr-playing-stats-grid">
        <div class="cr-playing-stat-card">
          <div class="cr-playing-stat-value"><%= @playing_stats[:overall][:pct] %>%</div>
          <div class="cr-playing-stat-label">Overall Win %</div>
          <div class="cr-playing-stat-detail"><%= @playing_stats[:overall][:won] %> of <%= @playing_stats[:overall][:total] %> matches</div>
        </div>
        <div class="cr-playing-stat-card">
          <div class="cr-playing-stat-value"><%= @playing_stats[:singles][:pct] %>%</div>
          <div class="cr-playing-stat-label">Singles Win %</div>
          <div class="cr-playing-stat-detail"><%= @playing_stats[:singles][:won] %> of <%= @playing_stats[:singles][:total] %> matches</div>
        </div>
        <div class="cr-playing-stat-card">
          <div class="cr-playing-stat-value"><%= @playing_stats[:doubles][:pct] %>%</div>
          <div class="cr-playing-stat-label">Doubles Win %</div>
          <div class="cr-playing-stat-detail"><%= @playing_stats[:doubles][:won] %> of <%= @playing_stats[:doubles][:total] %> matches</div>
        </div>
      </div>

      <%# Win % by Line %>
      <% if @playing_stats[:by_line].any? %>
        <h3 class="cr-section-subtitle" style="margin-top: 20px;">Win % by Line</h3>
        <div class="cr-playing-stats-table">
          <div class="cr-playing-stats-header">
            <span class="cr-ps-col-line">Line</span>
            <span class="cr-ps-col-stat">Win %</span>
            <span class="cr-ps-col-detail">Record</span>
          </div>
          <% @playing_stats[:by_line].sort_by { |k, _| k }.each do |label, data| %>
            <div class="cr-playing-stats-row">
              <span class="cr-ps-col-line"><%= label %></span>
              <span class="cr-ps-col-stat" style="font-weight: 700; color: <%= data[:pct] >= 50 ? 'var(--cr-green)' : 'var(--cr-red)' %>;"><%= data[:pct] %>%</span>
              <span class="cr-ps-col-detail"><%= data[:won] %> of <%= data[:total] %> matches</span>
            </div>
          <% end %>
        </div>
      <% end %>

      <%# Doubles Partners %>
      <% if @playing_stats[:partners].any? %>
        <h3 class="cr-section-subtitle" style="margin-top: 20px;">Doubles Partner Win %</h3>
        <div class="cr-playing-stats-table">
          <div class="cr-playing-stats-header">
            <span class="cr-ps-col-name">Partner</span>
            <span class="cr-ps-col-stat">Win %</span>
            <span class="cr-ps-col-detail">Record</span>
          </div>
          <% @playing_stats[:partners].each do |partner| %>
            <div class="cr-playing-stats-row">
              <span class="cr-ps-col-name"><%= partner[:name] %></span>
              <span class="cr-ps-col-stat" style="font-weight: 700; color: <%= partner[:pct] >= 50 ? 'var(--cr-green)' : 'var(--cr-red)' %>;"><%= partner[:pct] %>%</span>
              <span class="cr-ps-col-detail"><%= partner[:won] %> of <%= partner[:total] %> matches</span>
            </div>
          <% end %>
        </div>
        <% if @playing_stats[:best_partner] %>
          <div style="margin-top: 8px; font-size: 0.85rem; color: var(--cr-text-muted);">
            Best Doubles Partner: <strong><%= @playing_stats[:best_partner][:name] %></strong> (<%= @playing_stats[:best_partner][:pct] %>%)
          </div>
        <% end %>
      <% end %>

      <%# Recent Matches — tap a row to see the line's players + opponents %>
      <% if @playing_stats[:recent].any? %>
        <h3 class="cr-section-subtitle" style="margin-top: 20px;">Recent Matches</h3>
        <p style="font-size: 0.78rem; color: var(--cr-text-muted); margin: 0 0 8px;">Tap a match to see who played and who they faced.</p>
        <div class="cr-playing-stats-table">
          <div class="cr-playing-stats-header">
            <span class="cr-ps-col-name">Opponent</span>
            <span class="cr-ps-col-line">Line</span>
            <span class="cr-ps-col-stat">Score</span>
            <span class="cr-ps-col-detail">Result</span>
          </div>
          <% @playing_stats[:recent].each do |match| %>
            <details class="cr-ps-details">
              <summary class="cr-playing-stats-row cr-ps-summary">
                <span class="cr-ps-col-name">
                  <span class="cr-ps-caret">▸</span> vs. <%= match[:opponent] %>
                  <div style="font-size: 0.7rem; color: var(--cr-text-light);"><%= match[:team] %> · <%= match[:date].strftime("%-m/%-d/%y") %></div>
                </span>
                <span class="cr-ps-col-line"><%= match[:line_label] %></span>
                <span class="cr-ps-col-stat"><%= match[:score].presence || "—" %></span>
                <span class="cr-ps-col-detail">
                  <span class="cr-result-badge <%= match[:result] == 'win' ? 'cr-result-badge-win' : 'cr-result-badge-loss' %>">
                    <%= match[:result] == 'win' ? 'W' : 'L' %>
                  </span>
                </span>
              </summary>
              <div class="cr-ps-expand">
                <div class="cr-ps-expand-row">
                  <span class="cr-ps-expand-label">Our line</span>
                  <span class="cr-ps-expand-val">
                    <% players = match[:players] || [] %>
                    <% if players.any? %>
                      <% players.each_with_index do |pl, i| %>
                        <%= link_to pl[:name], player_path(pl[:id]), class: "cr-ps-playerlink" %><%= "," unless i == players.size - 1 %>
                      <% end %>
                    <% else %>—<% end %>
                  </span>
                </div>
                <div class="cr-ps-expand-row">
                  <span class="cr-ps-expand-label">Opponents</span>
                  <span class="cr-ps-expand-val">
                    <%= match[:opponents].present? ? match[:opponents] : "Not entered yet" %>
                  </span>
                </div>
              </div>
            </details>
          <% end %>
        </div>
      <% end %>
    </section>
  <% end %>

  <%# ── Teams ── %>
  <% if @teams.any? %>
    <section class="cr-section">
      <h2 class="cr-section-title">Teams</h2>
      <div class="cr-match-list">
        <% @teams.each do |team| %>
          <%= link_to team_path(team), class: "cr-match-row", style: "text-decoration: none; color: inherit;" do %>
            <div class="cr-match-date" style="min-width: auto; padding: 8px 14px;">
              <div class="cr-match-date-month" style="font-size: 0.6rem;"><%= team.league_category == "Local" ? "DEL-TRI" : team.league_category.upcase %></div>
            </div>
            <div class="cr-match-info">
              <div class="cr-match-opponent" style="font-size: 0.95rem;"><%= team.name %></div>
              <div class="cr-match-location"><%= team.team_type %> · <%= team.season_name %></div>
            </div>
            <% membership = team.team_memberships.find { |m| m.user_id == @user.id } %>
            <% if membership&.captain? %>
              <div class="cr-roster-role cr-roster-role-captain">Captain</div>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>

  <%# ── Personal league match history (auto-pulled from team rosters) ── %>
  <% if @is_self || @deltri_matches.present? %>
    <section class="cr-section">
      <h2 class="cr-section-title">League Match History</h2>

      <% if @is_self %>
        <p class="cr-deltri-hint">Your matches are pulled automatically from your teams' league pages — every cup or division you've played in, including teams you only subbed on. To add a league we don't have yet, paste your player-page link below.</p>
        <%= form_with url: connect_deltri_path, method: :post, local: true, class: "cr-deltri-connect" do %>
          <div class="cr-deltri-row">
            <input type="url" name="deltri_player_url" value="<%= @user.deltri_player_url %>"
                   placeholder="https://...tenniscores.com/player.php?p=..." class="cr-deltri-input">
            <button type="submit" class="cr-btn cr-btn-gold cr-deltri-btn"><%= @user.deltri_player_url.present? ? "Refresh" : "Add a link" %></button>
          </div>
        <% end %>
      <% end %>

      <% if @deltri_matches.present? %>
        <% @deltri_matches.each do |(league, division), matches| %>
          <% wins = matches.count(&:won?); losses = matches.size - wins %>
          <h3 class="cr-section-subtitle" style="margin-top: 18px;">
            <%= [ league, division ].reject(&:blank?).join(" · ").presence || "Matches" %>
            <span class="cr-deltri-record"><%= wins %>–<%= losses %></span>
          </h3>
          <div class="cr-match-list">
            <% matches.each do |m| %>
              <div class="cr-match-row cr-deltri-match">
                <div class="cr-match-date" style="min-width: auto; padding: 8px 12px;">
                  <div class="cr-match-date-month" style="font-size: 0.62rem;"><%= m.date_label %></div>
                </div>
                <div class="cr-match-info">
                  <div class="cr-match-opponent" style="font-size: 0.9rem;"><%= m.match_label %></div>
                  <div class="cr-match-location">
                    <%= m.line_label %><% if m.partner.present? %> · with <%= m.partner %><% end %><% if m.opponents.present? %> · vs <%= m.opponents %><% end %>
                  </div>
                </div>
                <div class="cr-deltri-outcome">
                  <span class="cr-result-badge <%= m.won? ? 'cr-result-badge-win' : 'cr-result-badge-loss' %>"><%= m.result_label %></span>
                  <% if m.score.present? %><span class="cr-deltri-score"><%= m.score %></span><% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      <% elsif @is_self %>
        <p class="cr-deltri-empty">No league matches pulled in yet — add your player-page link above to get started.</p>
      <% end %>
    </section>
  <% end %>

  <%# ── Advanced stats: clean per-year matrix, TennisRecord style ── %>
  <% if @stats.any? || @league_year_stats.present? %>
    <section class="cr-section" id="cr-advanced-stats">
      <h2 class="cr-section-title">Advanced Player Stats</h2>

      <%# Overall matrix (imported season totals: matches / sets / games / defaults) %>
      <% if @stats.any? %>
        <div class="cr-adv-league-label">Overall</div>
        <div class="cr-adv-wrap">
          <table class="cr-adv">
            <thead>
              <tr>
                <th class="cr-adv-rowhead">All Matches</th>
                <th>Total Matches</th><th>Win</th><th>Loss</th><th>WPct</th>
                <th class="cr-adv-group">Total Sets</th><th>Win</th><th>Loss</th><th>WPct</th>
                <th class="cr-adv-group">Total Games</th><th>Win</th><th>Loss</th><th>WPct</th>
                <th class="cr-adv-group">Defaults</th>
              </tr>
            </thead>
            <tbody>
              <% @stats.each do |s| %>
                <tr>
                  <td class="cr-adv-rowhead cr-adv-year"><%= s.year %></td>
                  <td><%= s.matches_total || "—" %></td>
                  <td class="cr-adv-win"><%= s.matches_won || "—" %></td>
                  <td class="cr-adv-loss"><%= s.matches_lost || "—" %></td>
                  <td><%= s.match_wpct ? sprintf("%.1f", s.match_wpct) : "—" %></td>
                  <td class="cr-adv-group"><%= s.sets_total || "—" %></td>
                  <td class="cr-adv-win"><%= s.sets_won || "—" %></td>
                  <td class="cr-adv-loss"><%= s.sets_lost || "—" %></td>
                  <td><%= s.set_wpct ? sprintf("%.1f", s.set_wpct) : "—" %></td>
                  <td class="cr-adv-group"><%= s.games_total || "—" %></td>
                  <td class="cr-adv-win"><%= s.games_won || "—" %></td>
                  <td class="cr-adv-loss"><%= s.games_lost || "—" %></td>
                  <td><%= s.game_wpct ? sprintf("%.1f", s.game_wpct) : "—" %></td>
                  <td class="cr-adv-group"><%= s.defaults || 0 %></td>
                </tr>
              <% end %>
              <%
                mt = @stats.sum { |s| s.matches_total.to_i }; mw = @stats.sum { |s| s.matches_won.to_i }; ml = @stats.sum { |s| s.matches_lost.to_i }
                st = @stats.sum { |s| s.sets_total.to_i };    sw = @stats.sum { |s| s.sets_won.to_i };    sl = @stats.sum { |s| s.sets_lost.to_i }
                gt = @stats.sum { |s| s.games_total.to_i };   gw = @stats.sum { |s| s.games_won.to_i };   gl = @stats.sum { |s| s.games_lost.to_i }
                df = @stats.sum { |s| s.defaults.to_i }
                pct = ->(w, t) { t.positive? ? sprintf("%.1f", w.to_f / t * 100) : "—" }
              %>
              <tr class="cr-adv-total">
                <td class="cr-adv-rowhead">Total</td>
                <td><%= mt %></td><td class="cr-adv-win"><%= mw %></td><td class="cr-adv-loss"><%= ml %></td><td><%= pct.call(mw, mt) %></td>
                <td class="cr-adv-group"><%= st %></td><td class="cr-adv-win"><%= sw %></td><td class="cr-adv-loss"><%= sl %></td><td><%= pct.call(sw, st) %></td>
                <td class="cr-adv-group"><%= gt %></td><td class="cr-adv-win"><%= gw %></td><td class="cr-adv-loss"><%= gl %></td><td><%= pct.call(gw, gt) %></td>
                <td class="cr-adv-group"><%= df %></td>
              </tr>
            </tbody>
          </table>
        </div>
      <% end %>

      <%# One matrix per league, from the results entered into Court Report %>
      <% if @league_year_stats.present? %>
        <% @league_year_stats.sort_by { |label, _| label.to_s }.each do |league, by_year| %>
          <div class="cr-adv-league-label"><%= league %></div>
          <div class="cr-adv-wrap">
            <table class="cr-adv cr-adv-compact">
              <thead>
                <tr>
                  <th class="cr-adv-rowhead"><%= league %></th>
                  <th>Matches</th><th>Win</th><th>Loss</th><th>WPct</th>
                </tr>
              </thead>
              <tbody>
                <% by_year.sort_by { |year, _| -year }.each do |year, c| %>
                  <tr>
                    <td class="cr-adv-rowhead cr-adv-year"><%= year %></td>
                    <td><%= c[:matches] %></td>
                    <td class="cr-adv-win"><%= c[:won] %></td>
                    <td class="cr-adv-loss"><%= c[:lost] %></td>
                    <td><%= c[:matches].positive? ? sprintf("%.1f", c[:won].to_f / c[:matches] * 100) : "—" %></td>
                  </tr>
                <% end %>
                <%
                  lm = by_year.values.sum { |c| c[:matches] }
                  lw = by_year.values.sum { |c| c[:won] }
                  ll = by_year.values.sum { |c| c[:lost] }
                %>
                <tr class="cr-adv-total">
                  <td class="cr-adv-rowhead">Total</td>
                  <td><%= lm %></td>
                  <td class="cr-adv-win"><%= lw %></td>
                  <td class="cr-adv-loss"><%= ll %></td>
                  <td><%= lm.positive? ? sprintf("%.1f", lw.to_f / lm * 100) : "—" %></td>
                </tr>
              </tbody>
            </table>
          </div>
        <% end %>
        <p class="cr-adv-note">Per-league tables count the lines you played from results entered into Court Report. The Overall table above shows your imported season totals.</p>
      <% end %>
    </section>
  <% end %>

</div>
