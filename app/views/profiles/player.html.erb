<% content_for :title, "#{@user.name} · Court Report" %>

<div class="cr-team-page">

  <%= link_to "← Back", :back, class: "cr-back-link" %>

  <% if @is_self %>
    <%# Phones hide the header name menu, so these links live here too. %>
    <div class="cr-founder-links">
      <%= link_to "Settings →", settings_path, class: "cr-btn cr-btn-outline cr-btn-compact" %>
      <% if current_user&.admin? %>
        <%= link_to "Site members →", admin_members_path, class: "cr-btn cr-btn-outline cr-btn-compact" %>
      <% end %>
    </div>
  <% end %>

  <%# ── Player Profile card — clean, Court Report's own rating (no TennisRecord) ── %>
  <%
    gender  = @teams.map { |t| t.gender.presence }.compact.first
    section = @teams.map { |t| t.section.presence }.compact.first
    # The meter places a live rating inside its 0.5 band; a flat NTRP has no
    # position in its band, so the meter is hidden with the Court Report rating.
    meter   = User::SHOW_COURT_REPORT_RATING ? rating_meter_data(rating: @user.court_report_rating || @user.ntrp_rating) : nil
  %>
  <div class="cr-pp">
    <div class="cr-pp-head">
      <span class="cr-pp-head-title">Player Profile</span>
      <a href="#cr-advanced-stats" class="cr-pp-head-link">Advanced Player Stats ↓</a>
    </div>

    <div class="cr-pp-body">
      <div class="cr-pp-left">
        <div class="cr-pp-row">
          <div>
            <%# Name and city sit on one line; the city never splits ("Villanova, / PA"),
                it moves under the name as a whole when the name is long. %>
            <div class="cr-pp-name">
              <span class="cr-pp-name-text"><%= @user.name %></span>
              <% if @user.location.present? %><span class="cr-pp-loc"><%= @user.location %></span><% end %>
            </div>
            <div class="cr-pp-sub">
              <% if @is_self %><span class="cr-pp-you">You</span><% end %>
              <% bits = [ ({ "F" => "Women's", "M" => "Men's" }[gender.to_s.upcase] || gender), (section.present? ? "USTA #{section}" : nil) ].compact %>
              <%= (" · " if @is_self && bits.any?) %><%= bits.join(" · ") %>
            </div>
          </div>
          <%# One true USTA (NTRP) rating per player; the date is when USTA
              published it (12/31 = the year-end rating). No rating → say so. %>
          <div class="cr-pp-metric">
            <% if @user.ntrp_rating.present? %>
              <div class="cr-pp-metric-val"><%= @user.ntrp_rating %></div>
              <div class="cr-pp-metric-cap">
                USTA rating<% if @user.ntrp_rating_date.present? %><br><%= @user.ntrp_rating_date.month == 12 && @user.ntrp_rating_date.day == 31 ? "year-end #{@user.ntrp_rating_date.year}" : "as of #{@user.ntrp_rating_date.strftime('%-m/%-d/%Y')}" %><% end %>
              </div>
            <% else %>
              <div class="cr-pp-metric-cap cr-pp-metric-none">No USTA<br>rating yet</div>
            <% end %>
          </div>
        </div>
        <% if @is_self %>
          <%# Optional: each player decides whether their city shows. %>
          <details class="cr-pp-city-edit">
            <summary><%= @user.location.present? ? "Edit city" : "Add your city (optional)" %></summary>
            <%= form_with url: profile_city_path, method: :post, local: true, class: "cr-pp-city-form" do %>
              <input type="text" name="city" value="<%= @user.location %>" maxlength="60"
                     placeholder="e.g. Villanova, PA" class="cr-deltri-input" aria-label="Your city">
              <button type="submit" class="cr-btn cr-btn-gold cr-deltri-btn">Save</button>
            <% end %>
            <p class="cr-pp-city-note">Leave it empty and save to hide your city.</p>
          </details>
        <% end %>

        <% if User::SHOW_COURT_REPORT_RATING %>
        <div class="cr-pp-row">
          <div class="cr-pp-label">Court Report Rating <span class="cr-pp-live">live</span></div>
          <div class="cr-pp-metric">
            <div class="cr-pp-metric-val cr-pp-gold">
              <%= @user.court_report_rating.present? ? sprintf("%.2f", @user.court_report_rating) : "—" %>
            </div>
            <div class="cr-pp-metric-cap">
              <% if @user.court_report_rating.present? %>from <%= @user.court_report_rating_lines %> lines<% else %>no scores yet<% end %>
            </div>
          </div>
        </div>

        <div class="cr-pp-row">
          <div class="cr-pp-label">How it's built</div>
          <div class="cr-pp-metric cr-pp-metric-note">
            Games won &amp; lost vs. each flight's level, averaged over the season.
          </div>
        </div>
        <% end %>
      </div>

      <% if meter %>
      <div class="cr-pp-right">
          <div class="cr-pp-meter-title"><%= meter[:title] %></div>
          <svg viewBox="0 0 260 150" class="cr-pp-meter" role="img" aria-label="Rating meter">
            <path d="M26,130 A104,104 0 0 1 45.86,68.87" fill="none" stroke="#dc2626" stroke-width="20" stroke-linecap="butt"/>
            <path d="M45.86,68.87 A104,104 0 0 1 97.86,31.09" fill="none" stroke="#f97316" stroke-width="20"/>
            <path d="M97.86,31.09 A104,104 0 0 1 162.14,31.09" fill="none" stroke="#eab308" stroke-width="20"/>
            <path d="M162.14,31.09 A104,104 0 0 1 214.14,68.87" fill="none" stroke="#84cc16" stroke-width="20"/>
            <path d="M214.14,68.87 A104,104 0 0 1 234,130" fill="none" stroke="#16a34a" stroke-width="20" stroke-linecap="butt"/>
            <line x1="130" y1="130" x2="<%= meter[:needle_x] %>" y2="<%= meter[:needle_y] %>"
                  stroke="#0a1628" stroke-width="4" stroke-linecap="round"/>
            <circle cx="130" cy="130" r="8" fill="#0a1628"/>
          </svg>
          <div class="cr-pp-meter-scale"><span>Low</span><span>Average</span><span>High</span></div>
          <div class="cr-pp-meter-band"><%= meter[:band_label] %></div>
      </div>
      <% end %>
    </div>
  </div>

  <%# ── Team switcher: see this player's stats one team at a time ── %>
  <% switch_teams = @current_teams + ([ @selected_team ] - @current_teams).compact %>
  <% if switch_teams.size > 1 || (@selected_team && switch_teams.any?) %>
    <div class="cr-team-switch">
      <label class="cr-team-switch-label" for="cr-team-select">Stats for</label>
      <select id="cr-team-select" class="cr-team-switch-select"
              onchange="if (this.value) window.location.href = this.value;">
        <option value="<%= player_path(@user) %>" <%= "selected" if @selected_team.nil? %>>All Teams</option>
        <%# Current teams only (past seasons are listed under Teams below). %>
        <% switch_teams.each do |t| %>
          <option value="<%= player_path(@user, team: t.id) %>" <%= "selected" if @selected_team&.id == t.id %>><%= t.name %></option>
        <% end %>
      </select>
    </div>
  <% end %>

  <%# ── Lineup Quick Facts — at-a-glance info captains need when setting a lineup ── %>
  <% if @playing_stats.present? %>
    <section class="cr-section cr-lineup-facts">
      <h2 class="cr-section-title">Lineup Quick Facts</h2>
      <div class="cr-lineup-facts-grid">
        <div class="cr-lineup-fact">
          <div class="cr-lineup-fact-label">Matches Played</div>
          <div class="cr-lineup-fact-value">
            <%= @playing_stats[:matches_played_total] %>
          </div>
        </div>

        <div class="cr-lineup-fact">
          <div class="cr-lineup-fact-label">Plays Singles?</div>
          <div class="cr-lineup-fact-value">
            <% if @playing_stats[:singles][:total] > 0 %>
              Yes · <%= @playing_stats[:singles][:total] %> match<%= @playing_stats[:singles][:total] == 1 ? "" : "es" %>
            <% else %>
              Not yet
            <% end %>
          </div>
        </div>

        <div class="cr-lineup-fact">
          <div class="cr-lineup-fact-label">Usual Doubles Line</div>
          <div class="cr-lineup-fact-value">
            <%= @playing_stats[:usual_doubles_line] || "—" %>
          </div>
        </div>

        <div class="cr-lineup-fact">
          <div class="cr-lineup-fact-label">Best Partner</div>
          <div class="cr-lineup-fact-value">
            <% if @playing_stats[:best_partner] %>
              <%= @playing_stats[:best_partner][:name] %>
              <span style="color: var(--cr-text-muted); font-weight: 500; font-size: 0.85rem;">(<%= @playing_stats[:best_partner][:pct] %>%, <%= @playing_stats[:best_partner][:total] %> matches)</span>
            <% else %>
              <span style="color: var(--cr-text-muted); font-weight: 500; font-size: 0.85rem;">Needs <%= ProfilesController::MIN_SAMPLE %>+ matches together</span>
            <% end %>
          </div>
        </div>
      </div>

      <% if @playing_stats[:matches_played_by_team].any? %>
        <div class="cr-lineup-fact-breakdown">
          <strong>Matches by team:</strong>
          <% @playing_stats[:matches_played_by_team].each_with_index do |t, i| %>
            <%= t[:team_name] %> (<%= t[:count] %>)<%= "," unless i == @playing_stats[:matches_played_by_team].size - 1 %>
          <% end %>
        </div>
      <% end %>

      <% if @playing_stats[:is_empty] %>
        <p style="text-align: center; padding: 10px; color: var(--cr-text-muted); font-size: 0.82rem; font-style: italic;">
          Stats will fill in here as match results are entered.
        </p>
      <% end %>
    </section>
  <% end %>

  <%# ── Playing Stats ── %>
  <% if @playing_stats.present? && !@playing_stats[:is_empty] %>
    <section class="cr-section">
      <h2 class="cr-section-title">Playing Stats</h2>
      <p class="cr-stats-scope"><%= render "profiles/stats_scope", record: @record, team: @selected_team %></p>

      <%# Overall stats row. No matches → "No singles yet", never "0%";
          under 3 matches → the record, but no % (too few to mean anything). %>
      <% min = ProfilesController::MIN_SAMPLE %>
      <div class="cr-playing-stats-grid">
        <% [ [ :overall, "Overall Win %", "matches" ], [ :singles, "Singles Win %", "singles" ], [ :doubles, "Doubles Win %", "doubles" ] ].each do |key, label, noun| %>
          <% d = @playing_stats[key] %>
          <div class="cr-playing-stat-card">
            <div class="cr-playing-stat-value<%= " cr-playing-stat-value-none" if d[:total] < min %>"><%= d[:total] >= min ? "#{d[:pct]}%" : "—" %></div>
            <div class="cr-playing-stat-label"><%= label %></div>
            <div class="cr-playing-stat-detail">
              <% if d[:total].zero? %>No <%= noun %> yet<% else %><%= d[:won] %> of <%= pluralize(d[:total], "match") %><%= " · % from #{min}" if d[:total] < min %><% end %>
            </div>
          </div>
        <% end %>
      </div>

      <%# Win % by Line %>
      <% if @playing_stats[:by_line].any? %>
        <h3 class="cr-section-subtitle" style="margin-top: 14px;">Win % by Line</h3>
        <div class="cr-playing-stats-table">
          <div class="cr-playing-stats-header">
            <span class="cr-ps-col-line">Line</span>
            <span class="cr-ps-col-stat">Win %</span>
            <span class="cr-ps-col-detail">Record</span>
          </div>
          <% @playing_stats[:by_line].sort_by { |k, _| k }.each do |label, data| %>
            <div class="cr-playing-stats-row">
              <span class="cr-ps-col-line"><%= label %></span>
              <% if data[:total] >= min %>
                <span class="cr-ps-col-stat" style="font-weight: 700; color: <%= data[:pct] >= 50 ? 'var(--cr-green)' : 'var(--cr-red)' %>;"><%= data[:pct] %>%</span>
              <% else %>
                <span class="cr-ps-col-stat cr-ps-col-muted">—</span>
              <% end %>
              <span class="cr-ps-col-detail"><%= data[:won] %>–<%= data[:total] - data[:won] %> (<%= pluralize(data[:total], "match") %>)</span>
            </div>
          <% end %>
        </div>
      <% end %>

      <%# Doubles Partners %>
      <% if @playing_stats[:partners].any? %>
        <h3 class="cr-section-subtitle" style="margin-top: 14px;">Doubles Partner Win %</h3>
        <div class="cr-playing-stats-table">
          <div class="cr-playing-stats-header">
            <span class="cr-ps-col-name">Partner</span>
            <span class="cr-ps-col-stat">Win %</span>
            <span class="cr-ps-col-detail">Record</span>
          </div>
          <% @playing_stats[:partners].each do |partner| %>
            <div class="cr-playing-stats-row">
              <span class="cr-ps-col-name"><%= partner[:name] %></span>
              <% if partner[:qualified] %>
                <span class="cr-ps-col-stat" style="font-weight: 700; color: <%= partner[:pct] >= 50 ? 'var(--cr-green)' : 'var(--cr-red)' %>;"><%= partner[:pct] %>%</span>
              <% else %>
                <span class="cr-ps-col-stat cr-ps-col-muted">—</span>
              <% end %>
              <span class="cr-ps-col-detail"><%= partner[:won] %>–<%= partner[:lost] %> (<%= pluralize(partner[:total], "match") %>)</span>
            </div>
          <% end %>
        </div>
        <div style="margin-top: 8px; font-size: 0.85rem; color: var(--cr-text-muted);">
          <% if @playing_stats[:best_partner] %>
            Best Doubles Partner: <strong><%= @playing_stats[:best_partner][:name] %></strong> (<%= @playing_stats[:best_partner][:pct] %>%, <%= @playing_stats[:best_partner][:won] %>–<%= @playing_stats[:best_partner][:lost] %>)
          <% end %>
          <div class="cr-ps-min-note">Win % and Best Partner need <%= min %>+ matches together.</div>
        </div>
      <% end %>

      <%# Recent Matches — tap a row to see the line's players + opponents %>
      <% if @playing_stats[:recent].any? %>
        <h3 class="cr-section-subtitle" style="margin-top: 14px;">Recent Matches</h3>
        <p style="font-size: 0.78rem; color: var(--cr-text-muted); margin: 0 0 8px;">Tap a match to see who played and who they faced.</p>
        <div class="cr-playing-stats-table">
          <div class="cr-playing-stats-header">
            <span class="cr-ps-col-name">Opponent</span>
            <span class="cr-ps-col-line">Line</span>
            <span class="cr-ps-col-stat">Score</span>
            <span class="cr-ps-col-detail">Result</span>
          </div>
          <% @playing_stats[:recent].each do |match| %>
            <details class="cr-ps-details">
              <summary class="cr-playing-stats-row cr-ps-summary">
                <span class="cr-ps-col-name">
                  <span class="cr-ps-caret">▸</span> <%= match[:from_league_site] ? match[:opponent].presence || "League match" : "vs. #{match[:opponent]}" %>
                  <div style="font-size: 0.7rem; color: var(--cr-text-light);"><%= match[:team] %> · <%= match[:date].strftime("%-m/%-d/%y") %></div>
                </span>
                <span class="cr-ps-col-line"><%= match[:line_label] %></span>
                <span class="cr-ps-col-stat"><%= match[:score].presence || "—" %></span>
                <span class="cr-ps-col-detail">
                  <span class="cr-result-badge <%= match[:result] == 'win' ? 'cr-result-badge-win' : 'cr-result-badge-loss' %>">
                    <%= match[:result] == 'win' ? 'W' : 'L' %>
                  </span>
                </span>
              </summary>
              <div class="cr-ps-expand">
                <div class="cr-ps-expand-row">
                  <span class="cr-ps-expand-label">Our line</span>
                  <span class="cr-ps-expand-val">
                    <% players = match[:players] || [] %>
                    <% if players.any? %>
                      <% players.each_with_index do |pl, i| %>
                        <%= link_to pl[:name], player_path(pl[:id]), class: "cr-ps-playerlink" %><%= "," unless i == players.size - 1 %>
                      <% end %>
                    <% else %>—<% end %>
                  </span>
                </div>
                <div class="cr-ps-expand-row">
                  <span class="cr-ps-expand-label">Opponents</span>
                  <span class="cr-ps-expand-val">
                    <% opps = match[:opponent_players] || [] %>
                    <% if opps.any? %>
                      <% opps.each_with_index do |op, i| %>
                        <% if op[:id] %>
                          <%= link_to op[:name], player_path(op[:id]), class: "cr-ps-playerlink" %>
                        <% else %>
                          <%= op[:name] %>
                        <% end %><%= "," unless i == opps.size - 1 %>
                      <% end %>
                    <% else %>Not entered yet<% end %>
                  </span>
                </div>
              </div>
            </details>
          <% end %>
        </div>
      <% end %>
    </section>
  <% end %>

  <%# ── Teams: current first, past seasons under their own heading ── %>
  <% if @current_teams.any? || @past_teams.any? %>
    <section class="cr-section">
      <h2 class="cr-section-title">Teams</h2>
      <% if @current_teams.any? %>
        <div class="cr-match-list">
          <% @current_teams.each do |team| %><%= render "profiles/team_row", team: team, user: @user %><% end %>
        </div>
      <% end %>
      <% if @past_teams.any? %>
        <h3 class="cr-section-subtitle" style="margin-top: 16px;">Past seasons</h3>
        <div class="cr-match-list cr-pp-past-teams">
          <% @past_teams.each do |team| %><%= render "profiles/team_row", team: team, user: @user %><% end %>
        </div>
      <% end %>
    </section>
  <% end %>

  <%# ── Personal league match history (auto-pulled from team rosters) ── %>
  <% if @selected_team.nil? && (@is_self || @deltri_matches.present?) %>
    <section class="cr-section" id="league-history">
      <h2 class="cr-section-title">League Match History</h2>

      <% if @is_self %>
        <%# The player-page link lives in Settings; here only a refresh control. %>
        <div class="cr-lmh-controls">
          <p class="cr-deltri-hint" style="margin: 0;">Pulled automatically from your teams' league websites, including teams you only subbed on.</p>
          <% if @user.deltri_player_url.present? %>
            <%= button_to "Refresh", refresh_deltri_path, method: :post, class: "cr-chip-btn" %>
          <% else %>
            <%= link_to "Add a league in Settings", settings_path(anchor: "league-link"), class: "cr-chip-btn" %>
          <% end %>
        </div>
      <% end %>

      <% if @deltri_matches.present? %>
        <% dup_count = @deltri_matches.values.flatten.count { |m| @counted_elsewhere_ids.include?(m.id) } %>
        <p class="cr-stats-scope">Only what the league websites publish (USTA isn't on them); matches with scores on Court Report are in Playing Stats above. Every match here is in the totals above<% if dup_count.positive? %>: <%= dup_count %> of them <%= dup_count == 1 ? "is the same match as a" : "are the same matches as" %> Court Report <%= "score".pluralize(dup_count) %>, so <%= dup_count == 1 ? "it's" : "they're" %> counted once<% end %>.</p>
        <% @deltri_matches.each do |(league, division), matches| %>
          <% wins = matches.count(&:won?); losses = matches.size - wins %>
          <h3 class="cr-section-subtitle" style="margin-top: 14px;">
            <%= [ league, division ].reject(&:blank?).join(" · ").presence || "Matches" %>
            <span class="cr-deltri-record"><%= wins %>–<%= losses %></span>
          </h3>
          <div class="cr-match-list">
            <% matches.each do |m| %>
              <div class="cr-match-row cr-deltri-match">
                <div class="cr-match-date" style="min-width: auto; padding: 8px 12px;">
                  <div class="cr-match-date-month" style="font-size: 0.62rem;"><%= m.date_label %></div>
                </div>
                <div class="cr-match-info">
                  <div class="cr-match-opponent" style="font-size: 0.9rem;"><%= m.match_label %></div>
                  <div class="cr-match-location">
                    <%= m.line_label %><% if m.partner.present? %> · with <%= m.partner %><% end %><% if m.opponents.present? %> · vs <%= m.opponents %><% end %>
                  </div>
                </div>
                <div class="cr-deltri-outcome">
                  <span class="cr-result-badge <%= m.won? ? 'cr-result-badge-win' : 'cr-result-badge-loss' %>"><%= m.result_label %></span>
                  <% if m.score.present? %><span class="cr-deltri-score"><%= m.score %></span><% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      <% elsif @is_self %>
        <p class="cr-deltri-empty">No league matches pulled in yet — add your player-page link above to get started.</p>
      <% end %>
    </section>
  <% end %>

  <%# ── Advanced stats: per-year matrix, same matches as Playing Stats ── %>
  <% if @year_stats.present? %>
    <section class="cr-section" id="cr-advanced-stats">
      <h2 class="cr-section-title">Advanced Player Stats</h2>
      <p class="cr-stats-scope"><%= render "profiles/stats_scope", record: @record, team: @selected_team %> The Overall table is every league together; each league's own table follows.</p>

      <div class="cr-adv-league-label">Overall<%= " · #{@selected_team.name}" if @selected_team %></div>
      <div class="cr-adv-wrap">
        <table class="cr-adv cr-adv-compact">
          <thead>
            <tr>
              <th class="cr-adv-rowhead">All leagues</th>
              <th>Matches</th><th>Win</th><th>Loss</th><th>WPct</th>
            </tr>
          </thead>
          <tbody>
            <% @year_stats.sort_by { |year, _| -year }.each do |year, c| %>
              <tr>
                <td class="cr-adv-rowhead cr-adv-year"><%= year %></td>
                <td><%= c[:total] %></td>
                <td class="cr-adv-win"><%= c[:won] %></td>
                <td class="cr-adv-loss"><%= c[:lost] %></td>
                <td><%= c[:total].positive? ? sprintf("%.1f", c[:won].to_f / c[:total] * 100) : "—" %></td>
              </tr>
            <% end %>
            <% ot = @playing_stats[:overall] %>
            <tr class="cr-adv-total">
              <td class="cr-adv-rowhead">Total</td>
              <td><%= ot[:total] %></td>
              <td class="cr-adv-win"><%= ot[:won] %></td>
              <td class="cr-adv-loss"><%= ot[:lost] %></td>
              <td><%= ot[:total].positive? ? sprintf("%.1f", ot[:won].to_f / ot[:total] * 100) : "—" %></td>
            </tr>
          </tbody>
        </table>
      </div>

      <%# One matrix per league — the same matches, split by league %>
      <% if @league_year_stats.present? %>
        <% @league_year_stats.sort_by { |label, _| label.to_s }.each do |league, by_year| %>
          <div class="cr-adv-league-label"><%= league %></div>
          <div class="cr-adv-wrap">
            <table class="cr-adv cr-adv-compact">
              <thead>
                <tr>
                  <th class="cr-adv-rowhead"><%= league %></th>
                  <th>Matches</th><th>Win</th><th>Loss</th><th>WPct</th>
                </tr>
              </thead>
              <tbody>
                <% by_year.sort_by { |year, _| -year }.each do |year, c| %>
                  <tr>
                    <td class="cr-adv-rowhead cr-adv-year"><%= year %></td>
                    <td><%= c[:matches] %></td>
                    <td class="cr-adv-win"><%= c[:won] %></td>
                    <td class="cr-adv-loss"><%= c[:lost] %></td>
                    <td><%= c[:matches].positive? ? sprintf("%.1f", c[:won].to_f / c[:matches] * 100) : "—" %></td>
                  </tr>
                <% end %>
                <%
                  lm = by_year.values.sum { |c| c[:matches] }
                  lw = by_year.values.sum { |c| c[:won] }
                  ll = by_year.values.sum { |c| c[:lost] }
                %>
                <tr class="cr-adv-total">
                  <td class="cr-adv-rowhead">Total</td>
                  <td><%= lm %></td>
                  <td class="cr-adv-win"><%= lw %></td>
                  <td class="cr-adv-loss"><%= ll %></td>
                  <td><%= lm.positive? ? sprintf("%.1f", lw.to_f / lm * 100) : "—" %></td>
                </tr>
              </tbody>
            </table>
          </div>
        <% end %>
      <% end %>
    </section>
  <% end %>

</div>
