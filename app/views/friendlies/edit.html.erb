  <section class="cr-rp-card">
    <div class="cr-rp-card-head">
      <h2 class="cr-rp-card-title">Edit friendly</h2>
    </div>
    <%= render "form", friendly: @friendly, url: friendly_path(@friendly), method: :patch %>
  </section>
</div>
