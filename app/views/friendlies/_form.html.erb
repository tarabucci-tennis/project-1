<% if friendly.errors.any? %>
  <p class="cr-fr-error"><%= friendly.errors.full_messages.to_sentence %></p>
<% end %>

<%= form_with model: friendly, url: url, method: method, data: { turbo: false }, class: "cr-fr-form" do |f| %>
  <label>Name <span>(optional)</span>
    <%= f.text_field :title, placeholder: "e.g. Saturday morning mixer" %>
  </label>
  <label>Date &amp; start time
    <%= f.datetime_local_field :starts_at, required: true %>
  </label>
  <fieldset class="cr-fr-length">
    <legend>How long is the court booked?</legend>
    <div class="cr-fr-length-opts">
      <% [ [ "90", "1½ hours" ], [ "120", "2 hours" ], [ "custom", "Other" ], [ "none", "Not sure" ] ].each do |val, label| %>
        <label class="cr-fr-length-opt">
          <%= f.radio_button :duration, val, checked: friendly.duration == val,
                onchange: "this.form.querySelector('.cr-fr-end-time').hidden = this.value !== 'custom'" %>
          <span><%= label %></span>
        </label>
      <% end %>
    </div>
    <label class="cr-fr-end-time" <%= "hidden" unless friendly.duration == "custom" %>>End time
      <%= f.time_field :end_time, value: friendly.end_time, step: 300 %>
    </label>
  </fieldset>
  <label>Where <span>(optional: club, street, town, separated by commas)</span>
    <%= f.text_field :location, placeholder: "e.g. Aronimink Golf Club, 3600 St Davids Rd, Newtown Square, PA" %>
  </label>
  <label>Sets to plan
    <%= f.select :sets_count, [ [ "1 set", 1 ], [ "2 sets", 2 ], [ "3 sets (if we can squeeze in a third)", 3 ] ] %>
  </label>
  <label>Note <span>(optional)</span>
    <%= f.text_area :notes, rows: 2, placeholder: "e.g. 4.0 level, bring a can of balls" %>
  </label>
  <% if friendly.new_record? %>
    <label class="cr-fr-radio">
      <%= check_box_tag :im_playing, "1", true %> I'm playing (add my name)
    </label>
  <% end %>
  <p class="cr-fr-hint-block">No need to count courts. People add their names from your link, and Court Report works out the courts: every 4 names = 1 court.</p>
  <button type="submit" class="cr-btn cr-btn-gold"><%= friendly.new_record? ? "Book it & get the link" : "Save" %></button>
<% end %>
