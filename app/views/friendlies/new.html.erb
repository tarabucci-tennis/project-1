<% content_for :title, "Book a friendly · Court Report" %>

<div class="cr-rp-page cr-rp-narrow">
  <%= link_to "← Friendlies", friendlies_path, class: "cr-back-link" %>

  <section class="cr-rp-card">
    <div class="cr-rp-card-head">
      <h2 class="cr-rp-card-title">🎾 Book a friendly</h2>
      <span class="cr-rp-card-note">You'll get one link to share. Anyone can add their name.</span>
    </div>
    <%= render "form", friendly: @friendly, url: friendlies_path, method: :post %>
  </section>
</div>
