<% content_for :title, "Friendlies · Court Report" %>

<div class="cr-rp-page cr-fr-index-page">
  <%= link_to "← My Teams", teams_path, class: "cr-back-link" %>

  <div class="cr-fr-index-head">
    <h1 class="cr-rp-name">Friendlies</h1>
    <%= link_to "+ Book a friendly", new_friendly_path, class: "cr-btn cr-btn-gold" %>
  </div>

  <% if @friendlies.any? %>
    <%# Same Header Band cards as the My Teams Friendlies tab: coming up first
        (soonest first), then past ones (latest first). %>
    <% upcoming, past = @friendlies.partition { |f| f.starts_at >= Time.current.beginning_of_day } %>
    <% if upcoming.any? %>
      <h2 class="cr-section-title cr-fr-past-title">Coming up</h2>
      <div class="cr-my-week-list cr-fr-list cr-band-grid">
        <% upcoming.sort_by(&:starts_at).each do |f| %>
          <%= render "teams/event_card", item: f %>
        <% end %>
      </div>
    <% end %>
    <% if past.any? %>
      <h2 class="cr-section-title cr-fr-past-title">Past friendlies</h2>
      <div class="cr-my-week-list cr-fr-list cr-band-grid cr-fr-past">
        <% past.each do |f| %>
          <%= render "teams/event_card", item: f %>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <p class="cr-coming-up-empty"><%= @archived_friendlies.any? ? "No friendlies showing. Your archived ones are below." : "No friendlies yet." %> Book one and share the link: people add their names and Court Report makes the lineup.</p>
  <% end %>

  <%# Archive (Tara, Nov 23 2026): hide friendlies from every list without deleting them. %>
  <% if @archivable_count.positive? %>
    <div class="cr-fr-archive-all">
      <%= button_to "Archive all friendlies I booked (#{@archivable_count})", archive_all_friendlies_path, method: :patch,
            class: "cr-btn cr-btn-outline",
            form: { data: { turbo_confirm: "Archive all #{@archivable_count} friendlies you booked? They leave your lists (and your players' lists) but aren't deleted. You can restore any of them." } } %>
      <p class="cr-fr-archive-note">To archive just one, open it and tap Archive.</p>
    </div>
  <% end %>
  <% if @archived_friendlies.any? %>
    <details class="cr-fr-archived">
      <summary>Archived friendlies (<%= @archived_friendlies.size %>)</summary>
      <ul class="cr-fr-archived-list">
        <% @archived_friendlies.each do |f| %>
          <li>
            <span class="cr-fr-archived-name"><%= link_to f.title, friendly_path(f) %> · <%= f.starts_at.strftime("%a, %b %-d, %Y") %></span>
            <% if f.organizer_id == current_user.id || current_user.admin? %>
              <%= button_to "Restore", archive_friendly_path(f), method: :patch, class: "cr-chip-btn", form: { class: "cr-fr-archived-form" } %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </details>
  <% end %>
</div>
