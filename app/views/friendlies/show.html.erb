<% content_for :title, "#{@friendly.title} · Court Report" %>
<% share_url = friendly_url(@friendly) %>
<% when_text = @friendly.starts_at.strftime("%a, %b %-d · %-l:%M %p") %>
<% claim_label = @friendly.courts.zero? ? "✓ Sign me up" : (@friendly.full? ? "Join the waitlist" : "✓ Count me in") %>
<% invite = "🎾 #{@friendly.title}: #{when_text}#{" at #{@friendly.location}" if @friendly.location.present?}. #{@friendly.courts.zero? ? "Courts to be booked" : "#{@friendly.courts} #{'court'.pluralize(@friendly.courts)}"}, first come first served. Claim a spot: #{share_url}" %>

<div class="cr-rp-page">
  <% if current_user %><%= link_to "← My Teams", teams_path, class: "cr-back-link" %><% end %>

  <section class="cr-rp-hero">
    <div class="cr-rp-hero-main">
      <div class="cr-rp-eyebrow">Friendly · organized by <%= @friendly.organizer.name %></div>
      <h1 class="cr-rp-name"><%= @friendly.title %></h1>
      <div class="cr-rp-sub">
        <%= @friendly.starts_at.strftime("%A, %B %-d · %-l:%M %p") %>
        <% if @friendly.location.present? %> · <%= @friendly.location %><% end %>
      </div>
    </div>
    <div class="cr-rp-hero-level">
      <% if @friendly.courts.zero? %>
        <div class="cr-rp-level-val"><%= @friendly.spots.size %></div>
        <div class="cr-rp-level-cap">signed up</div>
      <% else %>
        <div class="cr-rp-level-val"><%= @friendly.open_spots %></div>
        <div class="cr-rp-level-cap"><%= @friendly.open_spots == 1 ? "spot left" : "spots left" %></div>
      <% end %>
    </div>
  </section>

  <% if @friendly.notes.present? %>
    <p class="cr-fr-note"><%= @friendly.notes %></p>
  <% end %>

  <%# ── Claim / your status ── %>
  <section class="cr-rp-card cr-fr-claim">
    <% if @my_spot %>
      <% on_court = @friendly.players.include?(@my_spot) %>
      <div class="cr-fr-status">
        <strong><%= if on_court then "✓ You're in, #{@my_spot.name}!" elsif @friendly.courts.zero? then "You're signed up, #{@my_spot.name}. You'll be placed when courts are added." else "You're on the waitlist, #{@my_spot.name}." end %></strong>
        <%= button_to "Can't make it anymore", claim_friendly_path(@friendly), method: :delete,
              params: { spot_id: @my_spot.id }, class: "cr-chip-btn",
              form: { style: "display:inline;", data: { turbo_confirm: "Take your name off this friendly?" } } %>
      </div>
    <% else %>
      <%= form_with url: claim_friendly_path(@friendly), method: :post, data: { turbo: false }, class: "cr-fr-claim-form" do %>
        <% if current_user %>
          <button type="submit" class="cr-btn cr-btn-gold"><%= claim_label %></button>
        <% else %>
          <input type="text" name="name" placeholder="Your name" required maxlength="60" autocomplete="name">
          <button type="submit" class="cr-btn cr-btn-gold"><%= claim_label %></button>
        <% end %>
      <% end %>
      <p class="cr-rp-foot" style="padding: 8px 0 0;">
        <% if @friendly.courts.zero? %>
          No courts booked yet. Sign up now and you'll be placed in order as courts are added.
        <% else %>
          First come, first served<%= " · it's full, so new names go on the waitlist (they move up if a court is added)" if @friendly.full? %>.
        <% end %>
      </p>
    <% end %>
  </section>

  <%# ── Courts ── %>
  <section class="cr-fr-courts">
    <% @friendly.courts_with_players.each_with_index do |court, ci| %>
      <div class="cr-rp-card cr-fr-court">
        <div class="cr-rp-card-head"><h2 class="cr-rp-card-title">Court <%= ci + 1 %></h2>
          <span class="cr-rp-card-note"><%= court.compact.size %> / <%= Friendly::PER_COURT %></span></div>
        <ul class="cr-fr-list">
          <% court.each do |spot| %>
            <% if spot %>
              <li class="cr-fr-filled">
                <span class="cr-fr-check">✓</span> <%= spot.name %>
                <% if can_remove?(spot) && spot != @my_spot %>
                  <%= button_to "×", claim_friendly_path(@friendly), method: :delete, params: { spot_id: spot.id },
                        class: "cr-fr-remove", title: "Remove #{spot.name}",
                        form: { style: "display:inline;", data: { turbo_confirm: "Remove #{spot.name}?" } } %>
                <% end %>
              </li>
            <% else %>
              <li class="cr-fr-open">Open spot</li>
            <% end %>
          <% end %>
        </ul>
      </div>
    <% end %>
  </section>

  <% if organizer? %>
    <section class="cr-rp-card cr-fr-court-controls">
      <div>
        <strong><%= @friendly.courts %> <%= "court".pluralize(@friendly.courts) %></strong>
        <% if @friendly.room_for_another_court? %>
          <span class="cr-fr-hint">· <%= @friendly.waitlist.size %> waiting, enough for another court</span>
        <% end %>
      </div>
      <div class="cr-fr-court-btns">
        <% if @friendly.courts.positive? %>
          <%= button_to "➖ Remove a court", friendly_courts_path(@friendly), method: :patch, params: { change: -1 },
                class: "cr-chip-btn", form: { style: "display:inline;", data: { turbo_confirm: "Remove a court? Its players go back on the waitlist." } } %>
        <% end %>
        <% if @friendly.courts < Friendly::MAX_COURTS %>
          <%= button_to "➕ Add a court", friendly_courts_path(@friendly), method: :patch, params: { change: 1 },
                class: "cr-chip-btn", form: { style: "display:inline;" } %>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if @friendly.waitlist.any? %>
    <section class="cr-rp-card">
      <div class="cr-rp-card-head"><h2 class="cr-rp-card-title"><%= @friendly.courts.zero? ? "Signed up" : "Waitlist" %></h2>
        <span class="cr-rp-card-note"><%= @friendly.courts.zero? ? "Placed in this order when courts are added" : "Moves up if someone drops out or a court is added" %></span></div>
      <ol class="cr-fr-list cr-fr-wait">
        <% @friendly.waitlist.each do |spot| %>
          <li><%= spot.name %>
            <% if can_remove?(spot) && spot != @my_spot %>
              <%= button_to "×", claim_friendly_path(@friendly), method: :delete, params: { spot_id: spot.id },
                    class: "cr-fr-remove", form: { style: "display:inline;" } %>
            <% end %>
          </li>
        <% end %>
      </ol>
    </section>
  <% end %>

  <%# ── Share + calendar ── %>
  <div class="cr-rp-actions" style="margin-top: 14px;">
    <%= link_to "📅 Add to Google Calendar", friendly_google_calendar_url(@friendly, share_url: share_url),
          target: "_blank", rel: "noopener", class: "cr-chip-btn" %>
    <button type="button" class="cr-chip-btn" data-invite="<%= invite %>"
            onclick="var t=this.dataset.invite,b=this;if(navigator.share){navigator.share({text:t}).catch(function(){})}else if(navigator.clipboard){navigator.clipboard.writeText(t).then(function(){b.textContent='Copied ✓'})}">
      🔗 Share invite
    </button>
    <% if organizer? %>
      <%= button_to "Cancel friendly", friendly_path(@friendly), method: :delete, class: "cr-chip-btn",
            form: { style: "display:inline;", data: { turbo_confirm: "Cancel this friendly for everyone?" } } %>
    <% end %>
  </div>
  <% if organizer? %>
    <p class="cr-rp-foot" style="padding: 8px 0;">Share invite sends the link by text, WhatsApp or email on your phone (or copies it on a computer).
      Anyone with the link can claim a spot, with no account needed. You can remove anyone with ×.</p>
  <% end %>
</div>
