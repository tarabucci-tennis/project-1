<div class="cr-page cr-dt-page">
  <div class="cr-back-link" style="margin-bottom: 14px;">
    <%= link_to "← Back to #{@team.name} standings", team_path(@team, anchor: "standings"), style: "text-decoration: none;" %>
  </div>

  <header class="cr-dt-header">
    <h1 class="cr-dt-name"><%= @division_team.name %></h1>
    <p class="cr-dt-sub">
      <% if @division_team.position.present? %>#<%= @division_team.position %> in <%= @team.league_display_name %> · <% end %>
      <strong><%= @division_team.wins %></strong> pts
    </p>
  </header>

  <% if @error.present? %>
    <div class="cr-dt-empty">
      <%= @error %>
      <% if @division_team.source_url.present? %>
        <div style="margin-top: 10px;">
          <%= link_to "View on #{@team.league_label} →", @division_team.source_url, target: "_blank", rel: "noopener", class: "cr-dt-extlink" %>
        </div>
      <% end %>
    </div>
  <% else %>
    <%# Tap a match to open its line-by-line scorecard in a pop-up. The
        scorecard is fetched live only when opened, so the page stays fast. %>
    <div class="cr-dt-results">
      <% @results.each do |m| %>
        <button type="button" class="cr-dt-row cr-dt-row-btn"
                data-url="<%= scorecard_team_division_team_path(@team, @division_team, d: m.date_label) %>"
                data-title="<%= @division_team.name %> vs. <%= m.opponent.presence || "Opponent" %>"
                data-sub="<%= m.date_label %> · <%= m.home_label %> · <%= m.result %> <%= m.score %>"
                onclick="crOpenDtCard(this)">
          <span class="cr-dt-date"><%= m.date_label %></span>
          <span class="cr-dt-ha cr-dt-ha-<%= m.home ? 'home' : 'away' %>"><%= m.home ? "H" : "A" %></span>
          <span class="cr-dt-opp">vs <%= m.opponent.presence || "—" %></span>
          <span class="cr-dt-score"><%= m.score %></span>
          <span class="cr-result-badge <%= m.result == 'W' ? 'cr-result-badge-win' : (m.result == 'T' ? 'cr-result-badge-tie' : 'cr-result-badge-loss') %>"><%= m.result %></span>
        </button>
      <% end %>
    </div>

    <dialog id="cr-dt-dialog" class="cr-result-dialog" onclick="if (event.target === this) this.close()">
      <div class="cr-result-dialog-panel">
        <button type="button" class="cr-result-dialog-close" aria-label="Close"
                onclick="this.closest('dialog').close()">&times;</button>
        <div class="cr-result-dialog-date" id="cr-dt-dialog-sub"></div>
        <h3 class="cr-result-dialog-title" id="cr-dt-dialog-title"></h3>
        <div class="cr-sched-detail-title">Line Scores</div>
        <div id="cr-dt-dialog-body"></div>
      </div>
    </dialog>
    <script>
      function crOpenDtCard(btn) {
        var dlg = document.getElementById("cr-dt-dialog");
        var body = document.getElementById("cr-dt-dialog-body");
        document.getElementById("cr-dt-dialog-title").textContent = btn.dataset.title;
        document.getElementById("cr-dt-dialog-sub").textContent = btn.dataset.sub;
        body.innerHTML = '<p class="cr-result-detail-empty">Loading scorecard…</p>';
        dlg.showModal();
        fetch(btn.dataset.url, { headers: { "Accept": "text/html" } })
          .then(function (r) { return r.text(); })
          .then(function (html) { body.innerHTML = html; })
          .catch(function () { body.innerHTML = '<p class="cr-result-detail-empty">Couldn\'t load this scorecard right now.</p>'; });
      }
    </script>
    <p class="cr-dt-foot">
      Pulled live from <%= @team.league_label %>.
      <% if @division_team.source_url.present? %>
        <%= link_to "View source →", @division_team.source_url, target: "_blank", rel: "noopener", class: "cr-dt-extlink" %>
      <% end %>
    </p>
  <% end %>
</div>
