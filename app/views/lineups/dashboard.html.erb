<% content_for(:title) { "Lineups - Court Report" } %>

<%# One card, one row per upcoming match: date | team, opponent and when |
    lineup status | one small action. Columns line up row to row; the whole
    row opens the match. A player asked to confirm gets I'm in / Can't play
    on a line under the row. %>
<div class="cr-lu-page">
  <div class="cr-lu-head">
    <h1 class="cr-page-title">Lineups</h1>
    <p class="cr-home-subtitle">Every upcoming match across your teams.</p>
  </div>

  <% if @upcoming.empty? %>
    <div class="cr-lu-card cr-lu-empty">
      <p><strong>No upcoming matches.</strong></p>
      <p>When your captain schedules a match and posts the lineup, it shows up here.</p>
    </div>
  <% else %>
    <div class="cr-lu-card">
      <% @upcoming.each do |item| %>
        <% match = item[:match] %>
        <% team = item[:team] %>
        <% slot = item[:my_slot] %>
        <% pending = item[:published] && slot&.confirmation == "pending" %>
        <%
          status, tone =
            if !item[:published] then [ "Not posted", "muted" ]
            elsif slot&.confirmation == "confirmed" then [ "You're in ✓", "yes" ]
            elsif slot&.confirmation == "declined" then [ "Can't play", "no" ]
            elsif slot then [ "Please reply", "gold" ]
            else [ "Posted", "gold" ]
            end
          when_bits = [ match.match_date.strftime("%a"), match.match_time.presence,
                        (match.home? ? "Home" : ("Away" if match.away?)) ].compact
        %>
        <div class="cr-lu-row<%= ' has-reply' if pending %>"
             onclick="if (!event.target.closest('a,button,form')) window.location='<%= team_match_path(team, match) %>'">
          <div class="cr-lu-date" aria-hidden="true">
            <span><%= match.match_date.strftime("%b") %></span>
            <strong><%= match.match_date.strftime("%-d") %></strong>
          </div>
          <div class="cr-lu-info">
            <div class="cr-lu-team"><%= team.name %></div>
            <%= link_to "vs. #{match.opponent.presence || 'TBD'}", team_match_path(team, match), class: "cr-lu-opp" %>
            <div class="cr-lu-when"><%= when_bits.join(" · ") %><% if slot && item[:published] %> · You're on <strong><%= slot.try(:line_label) || "a line" %></strong><% end %></div>
          </div>
          <span class="cr-lu-status is-<%= tone %>"><%= status %></span>
          <div class="cr-lu-action">
            <% if item[:is_captain] %>
              <%= link_to item[:published] ? "Edit lineup" : "Set lineup", edit_team_match_lineup_path(team, match),
                    class: "cr-lu-btn#{' is-primary' unless item[:published]}" %>
            <% else %>
              <%= link_to "View", team_match_path(team, match), class: "cr-lu-btn" %>
            <% end %>
          </div>
          <% if pending %>
            <div class="cr-lu-reply">
              <span>Can you play <%= slot.try(:line_label) || "this line" %>?</span>
              <%= link_to "I'm in", confirm_team_match_lineup_path(team, match, status: "confirmed"), class: "cr-lu-btn is-yes" %>
              <%= link_to "Can't play", confirm_team_match_lineup_path(team, match, status: "declined"), class: "cr-lu-btn is-no" %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
