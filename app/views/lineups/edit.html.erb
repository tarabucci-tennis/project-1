<% content_for :title, "Set Lineup · #{@team.name} · Court Report" %>

<div class="cr-page">
  <%= link_to "← #{@team.name}", team_path(@team), class: "cr-back-link" %>

  <h1 class="cr-page-title">Set Lineup</h1>

  <div class="cr-result-match-info" style="margin-bottom: 24px;">
    <div class="cr-match-date">
      <div class="cr-match-date-month"><%= @match.match_date.strftime("%b").upcase %></div>
      <div class="cr-match-date-day"><%= @match.match_date.strftime("%-d") %></div>
    </div>
    <div class="cr-match-info">
      <div class="cr-match-opponent">vs. <%= @match.opponent %></div>
      <div class="cr-match-location">
        <%= @match.location %>
        <% if @match.match_time.present? %>
          · <%= @match.match_time %>
        <% end %>
      </div>
    </div>
    <% counts = @match.availability_counts %>
    <div style="text-align: right; font-size: 0.8rem; color: var(--cr-text-muted);">
      <span style="color: var(--cr-green); font-weight: 700;"><%= counts[:in] %> In</span> ·
      <span style="color: var(--cr-red); font-weight: 700;"><%= counts[:out] %> Out</span> ·
      <span><%= counts[:no_response] %> ?</span>
    </div>
  </div>
  <% said = @match.availabilities.includes(:user).where(status: %w[in out]).group_by(&:status) %>
  <% if said.any? %>
    <div class="cr-lineup-said">
      <% if said["in"] %><div><strong class="cr-lineup-said-yes">Can play:</strong> <%= said["in"].map { |a| a.user.name }.sort.join(", ") %></div><% end %>
      <% if said["out"] %><div><strong class="cr-lineup-said-no">Can't play:</strong> <%= said["out"].map { |a| a.user.name }.sort.join(", ") %></div><% end %>
    </div>
  <% end %>

  <p class="cr-lineup-help" style="font-size: 0.85rem; color: var(--cr-text-muted); margin-bottom: 16px; padding: 12px 14px; background: rgba(201, 162, 74, 0.08); border-left: 3px solid var(--cr-gold); border-radius: 6px;">
    Tap a name and then the line, or pick from each line's list. Tap <strong>&times;</strong> to take a player off a line, or <strong>Clear lineup</strong> to start over (nothing changes until you save). For a sub who isn't on the team, choose <strong>+ Write in a sub…</strong> at the bottom of the list and type their name. Leave <strong>Already confirmed</strong> checked if you've already gotten a yes via text or in person — those players won't get an email asking them to confirm again. Uncheck it only if you want the app to email the player and ask.
  </p>

  <% if @prefill_kind == :usual %>
    <p class="cr-lineup-carry">
      Filled in with who has played each line most this season (from <%= pluralize(@usual.matches_counted, "match") %> with line scores). Players who said they can't play are left out.
      Change any line you like. Nothing is saved until you press Save Draft or Post Lineup.
    </p>
  <% elsif @prefill.any? %>
    <p class="cr-lineup-carry">
      Filled in from last week's lineup (vs. <%= @prefill_from.opponent %>, <%= @prefill_from.match_date.strftime("%b %-d") %>).
      To put in a sub, pick a different player on that line. Nothing is saved until you press Save Draft or Post Lineup.
    </p>
  <% end %>

  <%= form_tag team_match_lineup_path(@team, @match), method: :patch, data: { controller: "lineup-pick" } do %>

    <%# Tap a name, then "Put … here" on a line. Players who said they can
        play come first, then no answer, then can't play; a dot shows which. %>
    <% answered = @match.availabilities.pluck(:user_id, :status).to_h %>
    <% order = { "in" => 0, nil => 1, "no_response" => 1, "out" => 2 } %>
    <div class="cr-lp-panel">
      <div class="cr-lp-head">
        <span class="cr-lp-title">Players</span>
        <span class="cr-lp-hint">Tap a name, then <strong>Put … here</strong> on a line.</span>
      </div>
      <div class="cr-lp-grid">
        <% @members.sort_by { |m| [ order.fetch(answered[m.id], 1), m.name.to_s.downcase ] }.each do |m| %>
          <% state = { "in" => "is-yes", "out" => "is-no" }[answered[m.id]] %>
          <button type="button" class="cr-lp-chip <%= state %>" data-lineup-pick-target="chip"
                  data-user-id="<%= m.id %>" data-first="<%= m.name.to_s.split.first %>"
                  data-action="lineup-pick#pick" aria-pressed="false"
                  title="<%= m.name %>: <%= { 'is-yes' => 'can play', 'is-no' => "can't play" }[state] || 'no answer yet' %>">
            <span class="cr-lp-dot" aria-hidden="true"></span>
            <span class="cr-lp-name"><%= m.name %></span>
            <span class="cr-lp-line" hidden></span>
          </button>
        <% end %>
      </div>
      <div class="cr-lp-key">
        <span><span class="cr-lp-dot is-yes"></span>Can play</span>
        <span><span class="cr-lp-dot"></span>No answer</span>
        <span><span class="cr-lp-dot is-no"></span>Can't play</span>
      </div>
    </div>

    <div class="cr-lineup-grid">
      <%# Iterate over the team's lineup_slot_plan so USTA teams get
          1S + 4×2D while Inter-Club and Del-Tri teams get 6×2D. %>
      <% @team.lineup_slot_plan.each do |(line_type, position), _slot_count| %>
        <% tri = line_type == "doubles" && @team.doubles_line_level(position) %>
        <% line_label = line_type == "singles" ? "#{position}S — Singles" : (tri ? "#{tri} — Doubles" : "#{position}D — Doubles #{position}") %>
        <div class="cr-lineup-line-card">
          <div class="cr-lineup-line-label"><%= line_label %></div>
          <% usual = @usual.for_line([ line_type, position ]).first(line_type == "singles" ? 2 : 3) %>
          <% if usual.any? %>
            <p class="cr-lineup-usual">Most often here:
              <% usual.each_with_index do |u, ui| %><%= " · " if ui > 0 %><span class="cr-lineup-usual-who"><%= u.user.name %> <strong><%= u.times %> of <%= u.of %></strong></span><% end %>
            </p>
          <% end %>
          <% slots_for_line = @slots.select { |s| s.line_type == line_type && s.position == position } %>
          <% slots_for_line.each_with_index do |slot, i| %>
            <div class="cr-lineup-slot-row">
              <button type="button" class="cr-lineup-spot" data-lineup-pick-target="spot" data-action="lineup-pick#place" hidden></button>
              <div class="cr-lineup-pickrow">
                <select name="slots[<%= slot.id %>][user_id]" class="cr-select" style="max-width: 100%;"
                        data-lineup-pick-target="select" data-line="<%= line_type == 'singles' ? "#{position}S" : (tri || "#{position}D") %>"
                        data-action="change->lineup-pick#changed"
                        onchange="var n = this.closest('.cr-lineup-slot-row').querySelector('.cr-lineup-sub-name'); n.hidden = this.value !== 'sub'; if (!n.hidden) n.focus()">
                  <% if line_type == "singles" %>
                    <option value="">-- Select player --</option>
                  <% else %>
                    <option value="">-- Select player <%= i + 1 %> --</option>
                  <% end %>
                  <% @members.each do |m| %>
                    <% picked = slot.user_id ? slot.user_id == m.id : @prefill[slot.id] == m.id %>
                    <option value="<%= m.id %>" <%= "selected" if picked %>><%= m.name %></option>
                  <% end %>
                  <% if @subs.any? %>
                    <optgroup label="Subs">
                      <% @subs.each do |u| %>
                        <option value="<%= u.id %>" <%= "selected" if slot.user_id == u.id %>><%= u.name %> (sub)</option>
                      <% end %>
                    </optgroup>
                  <% end %>
                  <option value="sub">+ Write in a sub…</option>
                </select>
                <button type="button" class="cr-lineup-clear" data-action="lineup-pick#clear"
                        aria-label="Remove the player from this spot" title="Remove from this spot">&times;</button>
              </div>
              <input type="text" name="slots[<%= slot.id %>][sub_name]" class="cr-lineup-sub-name" placeholder="Sub's name" maxlength="60" hidden aria-label="Sub's name">
              <label class="cr-lineup-confirmed-toggle">
                <input type="hidden" name="slots[<%= slot.id %>][confirmed]" value="0">
                <input type="checkbox" name="slots[<%= slot.id %>][confirmed]" value="1" <%= "checked" unless slot.declined? %>>
                <span>Already confirmed</span>
              </label>
              <% if (was = @last_week[slot.id]) %>
                <span class="cr-lineup-last-week">Last week: <%= was %></span>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="cr-form-actions cr-lineup-actions" style="margin-top: 24px;">
      <%= button_tag "Save Draft", type: :submit, name: "publish", value: "false", class: "cr-btn cr-btn-outline" %>
      <%= button_tag "Post Lineup", type: :submit, name: "publish", value: "true", class: "cr-btn cr-btn-gold" %>
      <%= link_to "Cancel", team_path(@team), class: "cr-btn cr-btn-outline" %>
      <button type="button" class="cr-lineup-clear-all" data-action="lineup-pick#clearAll">Clear lineup</button>
    </div>
  <% end %>
</div>
