<% content_for :title, "Player Ratings · Court Report" %>

<div class="cr-rp-page">
  <section class="cr-rp-hero">
    <div class="cr-rp-hero-main">
      <div class="cr-rp-eyebrow">Court Report</div>
      <h1 class="cr-rp-name">Player Ratings</h1>
      <div class="cr-rp-sub">USTA match history for every player we've seen: teammates, partners and opponents. Updates on its own as scores are entered.</div>
    </div>
  </section>

  <% if can_upload? %>
    <div class="cr-rp-actions">
      <%= link_to "Captains: upload TennisLink results (optional)", ratings_upload_path, class: "cr-chip-btn" %>
    </div>
  <% end %>

  <% if @players.any? %>
    <div data-controller="home-tabs">
      <div class="cr-home-tabs cr-rp-tabs">
        <button class="cr-home-tab cr-home-tab-active" data-home-tabs-target="tab" data-tab-key="players" data-action="click->home-tabs#switch">All players</button>
        <button class="cr-home-tab" data-home-tabs-target="tab" data-tab-key="teams" data-action="click->home-tabs#switch">Teams</button>
      </div>

      <%# ── Players: everyone, ranked by win % ── %>
      <section class="cr-rp-card cr-rp-panel-players" data-home-tabs-target="panel">
        <div class="cr-rp-card-head">
          <h2 class="cr-rp-card-title">Players (<%= @players.size %>)</h2>
          <input type="search" class="cr-rp-filter" placeholder="Find a player…" aria-label="Find a player"
                 oninput="var q=this.value.toLowerCase();document.querySelectorAll('.cr-rp-panel-players [data-rp-name]').forEach(function(r){r.style.display=r.dataset.rpName.indexOf(q)>-1?'':'none'})">
        </div>
        <%= render "ranked_table", rows: @players %>
      </section>

      <%# ── Teams: one dropdown per USTA team I'm on ── %>
      <div class="cr-rp-panel-teams" data-home-tabs-target="panel" style="display: none;">
        <% if @teams.any? %>
          <% @teams.each do |team, rows| %>
            <details class="cr-rp-card cr-rp-team">
              <summary class="cr-rp-card-head cr-rp-team-head">
                <span class="cr-rp-card-title"><%= team.name %></span>
                <span class="cr-rp-team-count"><%= rows.size %> <%= "player".pluralize(rows.size) %></span>
              </summary>
              <%= render "ranked_table", rows: rows %>
            </details>
          <% end %>
        <% else %>
          <section class="cr-rp-card cr-rp-empty"><p>You're not on any USTA teams yet.</p></section>
        <% end %>
      </div>

      <p class="cr-rp-foot">Ranked by win % (lines won ÷ lines played). A player needs <%= RatingsHistory::MIN_LINES_TO_RANK %>+ lines to get a rank, so a 2–0 start can't sit above a 10–3 season; players with fewer are listed after, unranked. On the Teams tab each player's record is her whole USTA record, not just that team. Fills in automatically from the scores entered on Court Report for USTA teams.</p>
    </div>
  <% else %>
    <section class="cr-rp-card cr-rp-empty">
      
      <p><strong>No USTA history yet.</strong></p>
      <p>As soon as line scores are entered for a USTA match (with the opponents' names), every player in it shows up here.</p>
    </section>
  <% end %>
</div>
