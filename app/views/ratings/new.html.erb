<% content_for :title, "Upload USTA Results · Court Report" %>

<div class="cr-rp-page">
  <%= link_to "← Player Ratings", ratings_path, class: "cr-back-link" %>

  <section class="cr-rp-card">
    <div class="cr-rp-card-head">
      <h2 class="cr-rp-card-title">Upload your USTA results</h2>
    </div>
    <ol class="cr-rp-steps">
      <li>Sign in to <strong>TennisLink</strong> and open your <strong>Individual Player Record</strong>.</li>
      <li>Tap <strong>Send To Excel</strong>. Your phone or computer saves a file ending in <strong>.xls</strong>.</li>
      <li>Choose that file below and tap <strong>Save my results</strong>.</li>
    </ol>
    <p class="cr-rp-foot">
      Every match in the file is saved, with partners, opponents and scores. A match a teammate already
      uploaded is skipped, so it's safe to upload again after each match. Nothing is ever deleted.
    </p>

    <%= form_with url: ratings_upload_path, method: :post, multipart: true, data: { turbo: false } do %>
      <div class="cr-rp-upload">
        <input type="file" name="file" accept=".xls,.xlsx,.html,.htm,text/html" required>
        <button type="submit" class="cr-btn cr-btn-gold">Save my results</button>
      </div>
    <% end %>
  </section>
</div>
