<% content_for :title, "Add a club · Court Report" %>

<div class="cr-rp-page">
  <%= link_to "← Back", back_path, class: "cr-back-link" %>
  <section class="cr-rp-card">
    <div class="cr-rp-card-head">
      <h2 class="cr-rp-card-title">📍 Add a <%= @club.league %> club</h2>
    </div>
    <%= render "form", club: @club, url: clubs_path, method: :post %>
  </section>
</div>
