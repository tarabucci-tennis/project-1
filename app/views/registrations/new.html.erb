<% content_for :title, "Sign Up — Court Report" %>

<div class="cr-auth-page">
  <div class="cr-auth-card">
    <div class="cr-auth-logo">
      <span class="cr-auth-logo-ball">🎾</span>
    </div>
    <h1 class="cr-auth-title">Sign Up</h1>
    <p class="cr-auth-sub">Create your free Court Report account</p>
    <ul class="cr-auth-perks" aria-label="What you get">
      <% [ "Schedules", "Availability", "Lineups", "Friendlies", "Ratings", "Stats" ].each do |perk| %>
        <li><%= icon(:check, size: 16) %><%= perk %></li>
      <% end %>
    </ul>

    <%= form_with url: signup_path, method: :post do |f| %>
      <%# Bot checks (see RegistrationsController): when the form was opened,
          and a box hidden from people that only bots fill in. %>
      <%= hidden_field_tag :form_started, Rails.application.message_verifier(:signup_form).generate(Time.current.to_i, expires_in: 1.day) %>
      <div class="cr-hp" aria-hidden="true">
        <label for="cr_contact_me">Leave this empty</label>
        <input type="text" id="cr_contact_me" name="cr_contact_me" tabindex="-1" autocomplete="off">
      </div>
      <div class="cr-field">
        <%= f.label :name, "Your name" %>
        <%= f.text_field :name, placeholder: "Jane Smith", autofocus: true, value: params[:name] %>
      </div>
      <div class="cr-field">
        <%= f.label :email, "Email address" %>
        <%= f.email_field :email, placeholder: "you@example.com", value: params[:email] %>
      </div>
      <div class="cr-field">
        <%= f.label :password, "Password" %>
        <div class="cr-password-wrap">
          <%= f.password_field :password, placeholder: "At least 6 characters" %>
          <button type="button" class="cr-password-toggle" onclick="togglePassword(this)" aria-label="Show password">Show</button>
        </div>
      </div>
      <div class="cr-field">
        <%= f.label :password_confirmation, "Confirm password" %>
        <div class="cr-password-wrap">
          <%= f.password_field :password_confirmation, placeholder: "Type it again" %>
          <button type="button" class="cr-password-toggle" onclick="togglePassword(this)" aria-label="Show password">Show</button>
        </div>
      </div>
      <%= f.submit "Sign Up →", class: "cr-auth-submit" %>
    <% end %>

    <p class="cr-auth-switch">
      Already have an account?
      <%= link_to "Sign in", login_path %>
    </p>
  </div>
</div>
