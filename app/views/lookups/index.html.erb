<% content_for :title, "Players & Teams · Court Report" %>

<div class="cr-home-page cr-lookup-page">

  <%= link_to "← My Teams", teams_path, class: "cr-back-link" %>

  <div class="cr-lookup-head">
    <h1 class="cr-page-title">Players &amp; Teams</h1>
    <p class="cr-home-subtitle">Everyone you play with and against, across all your leagues.</p>
  </div>

  <%# ── Search box ─────────────────────────────────────────────── %>
  <%= form_with url: lookup_path, method: :get, data: { turbo: false },
        class: "cr-lookup-search" do %>
    <input type="search" name="q" value="<%= @query %>"
           placeholder="Search players or teams"
           class="cr-lookup-input" autocomplete="off" />
    <button type="submit" class="cr-btn cr-btn-gold cr-btn-compact">Search</button>
    <% if @query.present? %>
      <%= link_to "Clear", lookup_path, class: "cr-btn cr-btn-outline cr-btn-compact" %>
    <% end %>
  <% end %>

  <% if @query.present? %>
    <p class="cr-lookup-result-note">
      Showing matches for “<strong><%= @query %></strong>” —
      <%= pluralize(@players.size, "player") %>,
      <%= pluralize(@my_teams_list.size + @opponent_teams.size, "team") %>.
    </p>
  <% end %>

  <%# ── Players ────────────────────────────────────────────────── %>
  <div class="cr-standings-wrap" style="margin-bottom: 26px;">
    <div class="cr-standings-head">
      <span class="cr-standings-head-title">Players (<%= @players.size %>)</span>
    </div>

    <% if @players.any? %>
      <div>
        <table class="cr-standings cr-lookup-tbl">
          <thead>
            <tr>
              <th>Player</th>
              <% if User::SHOW_COURT_REPORT_RATING %><th class="cr-st-n">YCR</th><% end %>
              <th class="cr-st-n">NTRP</th>
              <th class="cr-st-n">W</th>
              <th class="cr-st-n">L</th>
              <th class="cr-lookup-wide">Teams</th>
            </tr>
          </thead>
          <tbody>
            <% @players.each do |p| %>
              <tr class="cr-st-row">
                <td>
                  <%= link_to p[:user].name, player_path(p[:user].id), class: "cr-st-team" %>
                  <% if p[:user].id == current_user.id %>
                    <span style="color: var(--cr-gold); font-size: 0.72rem;">(you)</span>
                  <% end %>
                </td>
                <% if User::SHOW_COURT_REPORT_RATING %>
                <td class="cr-st-n">
                  <% if p[:ycr].present? %>
                    <%= link_to sprintf("%.2f", p[:ycr]), player_path(p[:user].id),
                          style: "color: var(--cr-gold); font-weight: 800; text-decoration: none;",
                          title: "Court Report Rating — tap for full stats" %>
                  <% else %>—<% end %>
                </td>
                <% end %>
                <td class="cr-st-n"><%= p[:ntrp].present? ? p[:ntrp] : "—" %></td>
                <td class="cr-st-n" style="color: var(--cr-green);"><%= p[:won] %></td>
                <td class="cr-st-n" style="color: var(--cr-red);"><%= p[:lost] %></td>
                <td class="cr-lookup-wide cr-lookup-muted">
                  <%= p[:teams].join(", ") %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <p class="cr-lookup-note"><% if User::SHOW_COURT_REPORT_RATING %>YCR = live Court Report Rating. <% end %>NTRP is the official USTA rating. Tap a name for full stats.</p>
    <% else %>
      <p class="cr-chart-empty-inline" style="padding: 18px;">
        <% if @query.present? %>No players match “<%= @query %>”.<% else %>No players yet.<% end %>
      </p>
    <% end %>
  </div>

  <%# ── My teams ───────────────────────────────────────────────── %>
  <div class="cr-standings-wrap" style="margin-bottom: 26px;">
    <div class="cr-standings-head">
      <span class="cr-standings-head-title">Your Teams (<%= @my_teams_list.size %>)</span>
    </div>

    <% if @my_teams_list.any? %>
      <table class="cr-standings cr-lookup-tbl">
        <thead>
          <tr>
            <th>Team</th>
            <th class="cr-st-n">W</th>
            <th class="cr-st-n">L</th>
            <th class="cr-st-n">Win%</th>
            <th class="cr-lookup-wide">League</th>
          </tr>
        </thead>
        <tbody>
          <% @my_teams_list.each do |team| %>
            <tr class="cr-st-row" onclick="if (!event.target.closest('a')) window.location='<%= team_path(team) %>'">
              <td><%= link_to team.name, team_path(team), class: "cr-st-team" %></td>
              <td class="cr-st-n" style="color: var(--cr-green);"><%= team.wins_count %></td>
              <td class="cr-st-n" style="color: var(--cr-red);"><%= team.losses_count %></td>
              <td class="cr-st-n"><%= team.win_pct ? "#{team.win_pct}%" : "—" %></td>
              <td class="cr-lookup-wide cr-lookup-muted"><%= team.league_label %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="cr-chart-empty-inline" style="padding: 18px;">
        <% if @query.present? %>None of your teams match “<%= @query %>”.<% else %>You're not on any teams yet.<% end %>
      </p>
    <% end %>
  </div>

  <%# ── Opponent teams in your divisions ───────────────────────── %>
  <div class="cr-standings-wrap">
    <div class="cr-standings-head">
      <span class="cr-standings-head-title">Opponents in Your Divisions (<%= @opponent_teams.size %>)</span>
    </div>

    <% if @opponent_teams.any? %>
      <table class="cr-standings cr-lookup-tbl">
        <thead>
          <tr>
            <th class="cr-st-n">#</th>
            <th>Team</th>
            <th class="cr-st-n">W</th>
            <th class="cr-st-n">L</th>
            <th class="cr-st-n">Pts</th>
            <th class="cr-lookup-wide">League</th>
          </tr>
        </thead>
        <tbody>
          <% @opponent_teams.each do |t| %>
            <tr class="cr-st-row">
              <td class="cr-st-n"><%= t[:position] || "—" %></td>
              <td><%= t[:name] %></td>
              <td class="cr-st-n" style="color: var(--cr-green);"><%= t[:wins].to_i %></td>
              <td class="cr-st-n" style="color: var(--cr-red);"><%= t[:losses].to_i %></td>
              <td class="cr-st-n"><%= t[:points].to_i.positive? ? t[:points] : "—" %></td>
              <td class="cr-lookup-wide cr-lookup-muted"><%= t[:league] %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <p class="cr-lookup-note">From each league's public standings.</p>
    <% else %>
      <p class="cr-chart-empty-inline" style="padding: 18px;">
        <% if @query.present? %>No opponent teams match “<%= @query %>”.<% else %>No opponent standings pulled yet.<% end %>
      </p>
    <% end %>
  </div>

  <p class="cr-lookup-note cr-lookup-foot">
    This shows the players and teams inside your own leagues — the people you
    actually play. Ratings and records are computed from the scores entered
    into Court Report.
  </p>

</div>
