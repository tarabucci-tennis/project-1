<% content_for :title, "Add a USTA team · Court Report" %>

<div class="cr-rp-page">
  <%= link_to "← My Teams", teams_path, class: "cr-back-link" %>

  <section class="cr-rp-card">
    <div class="cr-rp-card-head">
      <h2 class="cr-rp-card-title">Add a USTA team from TennisLink</h2>
    </div>
    <ol class="cr-rp-steps">
      <li>Sign in to <strong>TennisLink</strong> and open your team's <strong>Stats &amp; Standings</strong>.</li>
      <li>Tap <strong>Send To Excel</strong>. A file ending in <strong>.xls</strong> is saved.</li>
      <li>Choose that file below. You'll pick your team and see a preview <strong>before anything is saved</strong>.</li>
    </ol>
    <p class="cr-rp-foot">
      Sets up the team's league, flight, season, home club, format, captains, standings, matches and roster
      with everyone's USTA rating. Phone numbers and emails in the file are not saved.
      Already have the team? This just updates it.
    </p>
    <%= form_with url: preview_usta_teams_path, method: :post, multipart: true, data: { turbo: false } do %>
      <div class="cr-rp-upload">
        <input type="file" name="file" accept=".xls,.xlsx,.html,.htm,text/html" required>
        <button type="submit" class="cr-btn cr-btn-gold">Preview</button>
      </div>
    <% end %>
  </section>
</div>
