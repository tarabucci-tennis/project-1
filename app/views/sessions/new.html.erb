<% content_for :title, "Court Report — All Your Tennis Teams, One App" %>

<div class="cr-landing">

  <%# ── Hero section ── %>
  <div class="cr-landing-hero">
    <div class="cr-landing-hero-content">
      <h1 class="cr-landing-headline">
        All Your Teams.<br>
        <span class="cr-landing-headline-gold">One App.</span>
      </h1>
      <p class="cr-landing-tagline">
        Stop jumping between apps for different teams and leagues.
        Court Report puts your schedules, availability, lineups, friendlies, and stats in one place.
      </p>
    </div>
  </div>

  <%# ── Features ── %>
  <div class="cr-landing-features">
    <div class="cr-landing-feature">
      <div class="cr-landing-feature-head">
        <span class="cr-landing-feature-icon cr-tone-red"><%= icon(:calendar, size: 20) %></span>
        <span class="cr-landing-feature-title">See Your Week</span>
      </div>
      <div class="cr-landing-feature-text">All your matches in one calendar.</div>
    </div>
    <div class="cr-landing-feature">
      <div class="cr-landing-feature-head">
        <span class="cr-landing-feature-icon cr-tone-green"><%= icon(:check, size: 20) %></span>
        <span class="cr-landing-feature-title">Set Availability</span>
      </div>
      <div class="cr-landing-feature-text">Tell your captain you're in or out with one tap.</div>
    </div>
    <div class="cr-landing-feature">
      <div class="cr-landing-feature-head">
        <span class="cr-landing-feature-icon cr-tone-lime"><%= icon(:ball, size: 20) %></span>
        <span class="cr-landing-feature-title">Book Friendlies</span>
      </div>
      <div class="cr-landing-feature-text">Share one link, get a fair round-robin lineup.</div>
    </div>
    <div class="cr-landing-feature">
      <div class="cr-landing-feature-head">
        <span class="cr-landing-feature-icon cr-tone-orange"><%= icon(:trend, size: 20) %></span>
        <span class="cr-landing-feature-title">Player Ratings</span>
      </div>
      <div class="cr-landing-feature-text">Every player's USTA match history.</div>
    </div>
    <div class="cr-landing-feature">
      <div class="cr-landing-feature-head">
        <span class="cr-landing-feature-icon cr-tone-purple"><%= icon(:chart, size: 20) %></span>
        <span class="cr-landing-feature-title">Track Your Stats</span>
      </div>
      <div class="cr-landing-feature-text">Win %, partners and line history, automatic.</div>
    </div>
    <div class="cr-landing-feature">
      <div class="cr-landing-feature-head">
        <span class="cr-landing-feature-icon cr-tone-blue"><%= icon(:lineups, size: 20) %></span>
        <span class="cr-landing-feature-title">Captain Tools</span>
      </div>
      <div class="cr-landing-feature-text">Set lineups, see who's in, enter results.</div>
    </div>
  </div>

  <%# ── Sign in card ── %>
  <div class="cr-landing-signin">
    <div class="cr-login-card">
      <% if flash[:admin_reset_url].present? %>
        <div class="cr-admin-reset-box">
          <div class="cr-admin-reset-label">Admin reset link</div>
          <p class="cr-admin-reset-note">
            Click below to set a new password. Link expires in 2 hours.
          </p>
          <%= link_to "Reset my password →", flash[:admin_reset_url], class: "cr-btn cr-btn-gold cr-admin-reset-btn" %>
        </div>
      <% end %>

      <h2 style="font-size: 1.3rem; margin-bottom: 4px;">Get on the court</h2>
      <p class="cr-login-sub">Sign in with your email to see your teams</p>

      <% email_prefilled = params[:email].present? %>
      <%= form_with url: session_path, method: :post do |f| %>
        <div class="cr-field">
          <%= f.label :email, "Email address" %>
          <%= f.email_field :email, value: params[:email], placeholder: "you@example.com", autofocus: !email_prefilled %>
        </div>
        <div class="cr-field">
          <%= f.label :password, "Password" %>
          <div class="cr-password-wrap">
            <%= f.password_field :password, placeholder: "Your password", autofocus: email_prefilled %>
            <button type="button" class="cr-password-toggle" onclick="togglePassword(this)" aria-label="Show password">Show</button>
          </div>
        </div>
        <%= f.submit "Sign In →" %>
      <% end %>

      <p style="text-align: center; margin-top: 10px; font-size: 0.82rem; color: var(--cr-text-muted);">
        <%= link_to "Forgot password?", forgot_password_path, style: "color: var(--cr-gold); font-weight: 600;" %>
      </p>

      <p style="text-align: center; margin-top: 16px; font-size: 0.85rem; color: var(--cr-text-muted);">
        New here?
        <%= link_to "Create an account", signup_path, style: "color: var(--cr-gold); font-weight: 600;" %>
      </p>
    </div>
  </div>

  <%# ── Footer tagline ── %>
  <div class="cr-landing-footer">
    <p>Built for tennis players, captains, and coaches.</p>
    <p style="font-size: 0.75rem; margin-top: 4px;">USTA · Inter-Club · Del-Tri · and more</p>
  </div>

</div>
