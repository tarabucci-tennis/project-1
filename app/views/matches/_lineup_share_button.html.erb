<%# Share a published lineup by text (Messages / WhatsApp / email, or copies it
    on a computer without a share menu). Locals: match. %>
<button type="button" class="cr-chip-btn cr-share-btn" data-share-text="<%= lineup_share_text(match) %>"
        title="Text this lineup to your team" onclick="event.preventDefault(); event.stopPropagation(); crShare(this);">
  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 3v12"/><path d="M7 8l5-5 5 5"/><path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7"/>
  </svg>
  <span class="cr-share-label">Share lineup</span>
</button>
