<%# Bux-Mont / Del-Tri: where the match is played, under the teams.
    Club name, then street, then town, each on its own line, all lined up.
    Locals: venue (Club), link (false inside a <button>). %>
<% if venue %>
  <% tag_name = local_assigns.fetch(:link, true) ? :a : :span %>
  <%= content_tag tag_name, class: "cr-venue",
        **(tag_name == :a ? { href: venue.maps_url, target: "_blank", rel: "noopener", onclick: "event.stopPropagation();" } : {}) do %>
    <span class="cr-venue-pin" aria-hidden="true">📍</span>
    <span class="cr-venue-text">
      <span class="cr-venue-name"><%= venue.name %></span>
      <% venue.address_lines.each do |line| %>
        <span class="cr-venue-line"><%= line %></span>
      <% end %>
    </span>
  <% end %>
<% end %>
