<%# Renders a played match line-by-line, TennisRecord style: each line shows
    both pairs stacked, with the per-set game scores broken into columns and a
    W / L badge. Our players link to their profiles.
    Locals: match (a Match), team (its TennisTeam). %>
<% lines = match.match_lines.sort_by(&:position).select(&:scored?) %>
<%# TennisRecord only covers USTA, so the rating links show on USTA teams only. %>
<% tr_links = team.league_group == "USTA" %>
<% if lines.any? %>
  <div class="cr-sheet">
    <% lines.each do |line| %>
      <% our_row = { names: line.our_player_names, ids: line.match_line_players.map { |mlp| mlp.user_id },
                     games: line.our_games, won: line.won?, ours: true } %>
      <% opp_names = line.opponent_names.any? ? line.opponent_names : [ match.opponent ].compact %>
      <% opp_row = { names: opp_names, ids: [], games: line.their_games, won: line.lost?, ours: false,
                     real: line.opponent_names.any? } %>
      <% rows = line.won? ? [ our_row, opp_row ] : [ opp_row, our_row ] %>
      <div class="cr-sheet-line">
        <div class="cr-sheet-line-head">
          <span class="cr-sheet-line-label"><%= line.line_label %></span>
          <% if line.result.present? %>
            <span class="cr-result-badge <%= line.won? ? 'cr-result-badge-win' : 'cr-result-badge-loss' %>"><%= line.won? ? "W" : "L" %></span>
          <% end %>
        </div>
        <% rows.each do |row| %>
          <div class="cr-sheet-pair <%= 'cr-sheet-pair-win' if row[:won] %>">
            <span class="cr-sheet-names">
              <% if row[:names].any? %>
                <% row[:names].each_with_index do |nm, i| %>
                  <% pid = row[:ids][i] %>
                  <% if row[:ours] && pid %>
                    <%= link_to nm, player_path(pid), class: "cr-sheet-playerlink" %>
                  <% else %>
                    <%= nm %>
                  <% end %><% if tr_links && (row[:ours] || row[:real]) %><%= link_to icon(:chart, size: 13), tennis_record_url(nm), target: "_blank", rel: "noopener", class: "cr-sheet-tr-link", title: "#{nm}'s rating on TennisRecord", "aria-label": "#{nm}'s rating on TennisRecord" %><% end %><%= " / " unless i == row[:names].size - 1 %>
                <% end %>
              <% else %>
                <span style="color: var(--cr-text-light);"><%= row[:ours] ? "Our line" : "Opponent" %></span>
              <% end %>
            </span>
            <span class="cr-sheet-sets">
              <% row[:games].each do |g| %><span class="cr-sheet-set"><%= g %></span><% end %>
            </span>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% else %>
  <%# Only captains, co-captains and admins enter results (matches#update_results checks too). %>
  <% if team.league_group == "USTA" %>
    <%# Any teammate can upload the match's TennisLink scorecard (Send To Excel). %>
    <div class="cr-result-detail-empty cr-upload-card">
      <% if local_assigns[:can_enter_results] %>
        <p>No line scores yet. Type them in, or upload the match's TennisLink scorecard (<strong>Send To Excel</strong>).</p>
      <% else %>
        <p>No line scores yet. Open this match's scorecard on TennisLink, tap <strong>Send To Excel</strong>, then upload the file here.</p>
      <% end %>
      <div class="cr-upload-card-actions">
        <% if local_assigns[:can_enter_results] && !local_assigns[:hide_enter] %>
          <%= link_to "Enter scores", edit_results_team_match_path(team, match), class: "cr-btn cr-btn-gold cr-btn-compact" %>
        <% end %>
        <%= link_to "Upload Send To Excel file", usta_upload_team_path(team), class: "cr-btn #{local_assigns[:can_enter_results] ? 'cr-btn-outline' : 'cr-btn-gold'} cr-btn-compact" %>
      </div>
    </div>
  <% else %>
    <p class="cr-result-detail-empty">
      Line-by-line results haven't been entered yet.
      <% if local_assigns[:can_enter_results] && !local_assigns[:hide_enter] %><%= link_to "Enter scores →", edit_results_team_match_path(team, match), class: "cr-enter-results-link" %><% end %>
    </p>
  <% end %>
<% end %>
