<%# Renders a played match line-by-line, TennisRecord style: each line shows
    both pairs stacked, with the per-set game scores broken into columns and a
    W / L badge. Our players link to their profiles.
    Locals: match (a Match), team (its TennisTeam). %>
<% lines = match.match_lines.sort_by(&:position).select(&:scored?) %>
<% if lines.any? %>
  <%# Our pair is always on top and each pair is labelled with its team, so the
      W / L badge (always OUR team's result) can't be read as the top pair's
      (Tara's list #102/#114/#122). The league's line rule is stated once. %>
  <% rule = team.line_rule %>
  <% n_sets = lines.map { |l| l.set_games.size }.max.to_i %>
  <div class="cr-sheet">
    <p class="cr-sheet-rule"><%= team.line_rule_text %> W / L is <%= team.name %>'s result.</p>
    <% lines.each do |line| %>
      <% our_row = { team: team.name, names: line.our_player_names, ids: line.match_line_players.map { |mlp| mlp.user_id },
                     games: line.our_games, won: line.won?, ours: true } %>
      <% opp_names = line.opponent_names.any? ? line.opponent_names : [] %>
      <% opp_row = { team: match.opponent.presence || "Opponent", names: opp_names, ids: [], games: line.their_games, won: line.lost?, ours: false,
                     real: line.opponent_names.any? } %>
      <% tot = rule == :games ? line.games_total : line.sets_total %>
      <div class="cr-sheet-line">
        <div class="cr-sheet-line-head">
          <span class="cr-sheet-line-label"><%= line.line_label %></span>
          <% if line.result.present? %>
            <span class="cr-result-badge <%= line.won? ? 'cr-result-badge-win' : 'cr-result-badge-loss' %>" title="<%= team.name %> <%= line.won? ? 'won' : 'lost' %> this line"><%= line.won? ? "W" : "L" %></span>
          <% end %>
          <% if line.set_games.any? %>
            <span class="cr-sheet-total"><%= tot[0] %>–<%= tot[1] %> <%= rule == :games ? "games" : "sets" %></span>
          <% end %>
          <% if line.entered_by %>
            <span class="cr-sheet-entered">Entered by <%= line.entered_by.name.to_s.split.first %><%= " · #{line.entered_at.strftime('%b %-d')}" if line.entered_at %></span>
          <% end %>
        </div>
        <% if n_sets.positive? %>
          <div class="cr-sheet-pair cr-sheet-sethead" aria-hidden="true">
            <span class="cr-sheet-names"></span>
            <span class="cr-sheet-sets"><% n_sets.times do |i| %><span class="cr-sheet-set">Set <%= i + 1 %></span><% end %></span>
          </div>
        <% end %>
        <% [ our_row, opp_row ].each do |row| %>
          <div class="cr-sheet-pair <%= 'cr-sheet-pair-win' if row[:won] %> <%= row[:ours] ? 'cr-sheet-pair-ours' : 'cr-sheet-pair-theirs' %>">
            <span class="cr-sheet-names">
              <span class="cr-sheet-team"><%= row[:team] %></span>
              <% if row[:names].any? %>
                <% row[:names].each_with_index do |nm, i| %>
                  <% pid = row[:ids][i] %>
                  <% if row[:ours] && pid %>
                    <%= link_to nm, player_path(pid), class: "cr-sheet-playerlink" %>
                  <% else %>
                    <%= nm %>
                  <% end %><%= " / " unless i == row[:names].size - 1 %>
                <% end %>
              <% else %>
                <span class="cr-sheet-noname"><%= row[:ours] ? "Our line" : "Names not entered" %></span>
              <% end %>
            </span>
            <span class="cr-sheet-sets">
              <% n_sets.times do |i| %><span class="cr-sheet-set"><%= row[:games][i] || "" %></span><% end %>
            </span>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% else %>
  <%# Only captains, co-captains and admins enter results (matches#update_results checks too). %>
  <% if team.league_group == "USTA" %>
    <%# Any teammate can upload the match's TennisLink scorecard (Send To Excel). %>
    <div class="cr-result-detail-empty cr-upload-card">
      <% if local_assigns[:can_enter_results] %>
        <p>No line scores yet. Type them in, or upload the match's TennisLink scorecard (<strong>Send To Excel</strong>).</p>
      <% else %>
        <p>No line scores yet. Open this match's scorecard on TennisLink, tap <strong>Send To Excel</strong>, then upload the file here.</p>
      <% end %>
      <div class="cr-upload-card-actions">
        <% if local_assigns[:can_enter_results] && !local_assigns[:hide_enter] %>
          <%= link_to "Enter scores", edit_results_team_match_path(team, match), class: "cr-btn cr-btn-gold cr-btn-compact" %>
        <% end %>
        <%= link_to "Upload Send To Excel file", usta_upload_team_path(team), class: "cr-btn #{local_assigns[:can_enter_results] ? 'cr-btn-outline' : 'cr-btn-gold'} cr-btn-compact" %>
      </div>
    </div>
  <% else %>
    <p class="cr-result-detail-empty">
      Line-by-line results haven't been entered yet.
      <% if local_assigns[:can_enter_results] && !local_assigns[:hide_enter] %><%= link_to "Enter scores →", edit_results_team_match_path(team, match), class: "cr-enter-results-link" %><% end %>
    </p>
  <% end %>
<% end %>
