<% content_for :title, "Check USTA upload · Court Report" %>

<div class="cr-page" style="max-width: 760px; margin: 0 auto; padding: 24px;">
  <%= link_to "← Choose a different file", usta_upload_team_path(@team), class: "cr-back-link" %>

  <h1 class="cr-section-title" style="margin-top: 8px;">Check before saving</h1>
  <p style="color: var(--cr-text-muted); font-size: 0.9rem; margin-bottom: 14px;">
    <strong><%= @parsed.league %></strong> · <%= @parsed.flight %>
    <% if @parsed.season_start %> · <%= @parsed.season_start.strftime("%-m/%-d/%Y") %>–<%= @parsed.season_end&.strftime("%-m/%-d/%Y") %><% end %>
  </p>

  <% @plan.warnings.each do |w| %>
    <div style="margin-bottom: 14px; padding: 12px 14px; background: #fdecea; border: 1px solid #f5c6cb; border-radius: 10px; color: #a12a2a; font-size: 0.88rem;"><%= w %></div>
  <% end %>

  <div class="cr-sched-detail-title">Flight standings (as USTA publishes them)</div>
  <div class="cr-standings-scroll">
    <table class="cr-standings-tbl">
      <thead><tr><th>Team</th><th>Played</th><th>Points</th><th>Sets</th><th>Games</th><th>Games %</th></tr></thead>
      <tbody>
        <% @parsed.standings.each do |s| %>
          <tr<%= ' class="cr-standings-tbl-self"'.html_safe if s == @plan.our_row %>>
            <td><%= s.name %><% if s == @plan.our_row %> <span class="cr-standings-you-badge">You</span><% end %></td>
            <td><%= s.matches_played %></td>
            <td><strong><%= s.points %></strong></td>
            <td><%= s.sets_won %>–<%= s.sets_lost %></td>
            <td><%= s.games_won %>–<%= s.games_lost %></td>
            <td><%= sprintf("%.2f%%", s.games_won_pct) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="cr-sched-detail-title" style="margin-top: 18px;">Matches</div>
  <% if @parsed.matches.empty? %>
    <p class="cr-result-detail-empty">No matches listed yet.</p>
  <% else %>
    <ul style="font-size: 0.88rem; line-height: 1.7; margin-left: 18px;">
      <% @parsed.matches.sort_by(&:date).each do |m| %>
        <li>
          <%= m.date.strftime("%-m/%-d") %> vs <%= m.opponent %> —
          <% if m.played? %><strong><%= m.our_points %>–<%= m.their_points %></strong> <%= m.result == "win" ? "W" : (m.result == "loss" ? "L" : "T") %><% else %>not played yet<% end %>
          <% if m.status.present? %><span style="color: var(--cr-text-light);"> · <%= m.status %></span><% end %>
          <% if @plan.matches_new.include?(m) %><span class="cr-tag cr-tag-home">new</span><% elsif @plan.matches_updated.include?(m) %><span class="cr-tag cr-tag-playoff">updated</span><% end %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <div class="cr-sched-detail-title" style="margin-top: 18px;">Roster (<%= @parsed.players.size %> players)</div>
  <p style="font-size: 0.88rem; line-height: 1.6;">
    <% if @plan.players_new.any? %><strong>Adding <%= @plan.players_new.size %>:</strong> <%= @plan.players_new.join(", ") %><br><% end %>
    <% if @plan.ratings_changed.any? %><strong>USTA rating updates:</strong> <%= @plan.ratings_changed.join(" · ") %><% end %>
    <% if @plan.players_new.empty? && @plan.ratings_changed.empty? %>Everyone's already on the team with the right rating.<% end %>
  </p>

  <%= form_with url: usta_upload_confirm_team_path(@team), method: :post, data: { turbo: false } do %>
    <input type="hidden" name="token" value="<%= @token %>">
    <div style="display: flex; gap: 10px; margin-top: 18px;">
      <button type="submit" class="cr-btn cr-btn-gold" style="padding: 10px 22px;">Save to <%= @team.name %></button>
      <%= link_to "Cancel", team_path(@team), class: "cr-chip-btn" %>
    </div>
  <% end %>
</div>
