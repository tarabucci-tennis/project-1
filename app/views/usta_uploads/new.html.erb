<% content_for :title, "Upload USTA file · Court Report" %>

<div class="cr-page" style="max-width: 760px; margin: 0 auto; padding: 24px;">
  <%= link_to "← Back to #{@team.name}", team_path(@team), class: "cr-back-link" %>

  <h1 class="cr-section-title" style="margin-top: 8px;">Upload USTA Team Summary</h1>
  <ol style="color: var(--cr-text-muted); font-size: 0.9rem; line-height: 1.6; margin: 0 0 18px 18px;">
    <li>On <strong>tennislink.usta.com</strong>, sign in and open <strong><%= @team.name %></strong>'s <strong>Stats &amp; Standings</strong>.</li>
    <li>Tap <strong>Send To Excel</strong> and save the file.</li>
    <li>Choose that file below. You'll see what will change <strong>before anything is saved</strong>.</li>
  </ol>

  <%= form_with url: usta_upload_team_path(@team), method: :post, multipart: true, data: { turbo: false } do %>
    <div style="display: flex; gap: 10px; flex-wrap: wrap; align-items: center; background: var(--cr-white); border: 1px solid var(--cr-border); border-radius: 10px; padding: 16px;">
      <input type="file" name="file" accept=".xls,.xlsx,.html,.htm,text/html" style="flex: 1; min-width: 200px;">
      <button type="submit" class="cr-btn cr-btn-gold" style="padding: 9px 20px;">Preview</button>
    </div>
  <% end %>

  <p style="font-size: 0.8rem; color: var(--cr-text-light); margin-top: 12px;">
    Updates the flight standings (USTA's published numbers), each match's team score and Confirmed status,
    and players' official USTA ratings. Line-by-line scores aren't in this file, so they're left alone.
  </p>
</div>
