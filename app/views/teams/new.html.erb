<% content_for :title, "Create a Team · Court Report" %>

<div class="cr-page" style="max-width: 500px; margin: 0 auto; padding: 32px 24px;">
  <h1 class="cr-page-title" style="margin-bottom: 8px;">Create a Team</h1>
  <p style="color: var(--cr-text-muted); font-size: 0.9rem; margin-bottom: 24px;">
    You'll be the captain. Add players later from the Captain tab.
  </p>

  <%# ── Start from a previous team (Tara, Nov 23 2026) ── %>
  <% if @replicable_teams.present? %>
    <section class="cr-replicate">
      <h2 class="cr-replicate-title">Start from a previous team</h2>
      <p class="cr-replicate-sub">Pick a team you captained. Its league, home court and roster fill in below; the old team isn't changed.</p>
      <%= form_with url: new_team_path, method: :get, local: true, class: "cr-replicate-row" do %>
        <select name="from" class="cr-replicate-select" aria-label="Previous team">
          <option value="">Choose a team…</option>
          <%# Grouped by year, newest first: "2026 Teams", "2025 Teams"… (Tara, Nov 23 2026). %>
          <% year_of = ->(t) { t.start_date&.year || t.season_name.to_s[/\b(20\d\d)\b/, 1]&.to_i || t.created_at.year } %>
          <% @replicable_teams.group_by(&year_of).sort_by { |y, _| -y }.each do |year, teams| %>
            <optgroup label="<%= year %> Teams">
              <% teams.each do |t| %>
                <% detail = [ t.league_group, t.season_name.presence ].compact.join(" ") %>
                <option value="<%= t.id %>" <%= "selected" if @source_team&.id == t.id %>><%= t.name %><%= " – #{detail}" if detail.present? %></option>
              <% end %>
            </optgroup>
          <% end %>
        </select>
        <button type="submit" class="cr-btn cr-btn-gold cr-replicate-btn">Copy this team</button>
      <% end %>
    </section>
  <% end %>

  <% src = @source_team %>
  <% roster_count = src ? src.team_memberships.where(archived_season: nil).where.not(user_id: current_user.id).count : 0 %>
  <%= form_with url: create_team_path, method: :post, local: true do |f| %>
    <% if src %>
      <%= hidden_field_tag :from_team_id, src.id %>
      <div class="cr-replicate-note">
        Copying from <strong><%= src.name %></strong>. Change the name and season for the new team.
        <label class="cr-replicate-check">
          <%= check_box_tag :copy_roster, "1", true %>
          Bring the roster (<%= pluralize(roster_count, "player") %>)
        </label>
      </div>
    <% end %>
    <div class="cr-field">
      <%= f.label :name, "Team Name" %>
      <%= f.text_field :name, value: (params[:name].presence || src&.name), placeholder: "e.g. Kiss My Ace", required: true,
          style: "width: 100%; padding: 12px 16px; border: 1px solid var(--cr-border); border-radius: 8px; font-size: 1rem;" %>
    </div>

    <%# League menu (Tara, Nov 23 2026): her leagues by name, other areas' leagues, or "Other". %>
    <% chosen = params[:league_choice].presence || src&.league_choice_key || "usta" %>
    <% typed = params[:league_name].presence || (src && %w[local other].include?(src.league_choice_key) ? src.league_name : nil) %>
    <div class="cr-field">
      <label for="league_choice">League</label>
      <select name="league_choice" id="league_choice" class="cr-league-select"
              onchange="var o=document.getElementById('cr-league-name-field');o.hidden=!(this.value==='local'||this.value==='other');if(!o.hidden)o.querySelector('input').focus();">
        <% TennisTeam.league_menu_choices.group_by { |c| c[:group] }.each do |group, choices| %>
          <optgroup label="<%= group %>">
            <% choices.each do |c| %>
              <option value="<%= c[:key] %>" <%= "selected" if c[:key] == chosen %>><%= c[:label] %></option>
            <% end %>
          </optgroup>
        <% end %>
      </select>
    </div>

    <div class="cr-field" id="cr-league-name-field" <%= "hidden" unless %w[local other].include?(chosen) %>>
      <label for="league_name">League name</label>
      <input type="text" name="league_name" id="league_name" value="<%= typed %>" placeholder="e.g. Main Line Women's League"
             style="width: 100%; padding: 12px 16px; border: 1px solid var(--cr-border); border-radius: 8px; font-size: 1rem;">
    </div>

    <div class="cr-field">
      <%= f.label :team_type, "Division / Type (optional)" %>
      <%= f.text_field :team_type, value: (params[:team_type].presence || src&.team_type), placeholder: "e.g. Adult 40+, Adult 18+",
          style: "width: 100%; padding: 12px 16px; border: 1px solid var(--cr-border); border-radius: 8px; font-size: 1rem;" %>
    </div>

    <div class="cr-field">
      <%= f.label :season_name, "Season (optional)" %>
      <%= f.text_field :season_name, value: params[:season_name], placeholder: "e.g. Spring 2026", list: "cr-season-options",
          style: "width: 100%; padding: 12px 16px; border: 1px solid var(--cr-border); border-radius: 8px; font-size: 1rem;" %>
    </div>

    <% this_year = Date.current.year %>
    <datalist id="cr-season-options">
      <% [ this_year, this_year + 1 ].each do |y| %>
        <% %w[Winter Spring Summer Fall].each do |season| %><option value="<%= season %> <%= y %>"><% end %>
      <% end %>
      <option value="<%= this_year %>-<%= (this_year + 1).to_s.last(2) %>">
    </datalist>

    <div style="margin-top: 24px;">
      <%= f.submit "Create Team", class: "cr-btn cr-btn-gold", style: "width: 100%; padding: 14px; font-size: 1rem;" %>
      <%# A plain link back to My Teams; it's outside the form's submit, so nothing is saved. %>
      <p class="cr-form-cancel"><%= link_to "Cancel", teams_path %></p>
    </div>
  <% end %>
</div>
