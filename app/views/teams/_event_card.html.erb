<%# A friendly (shared sign-up link) or a team clinic/friendly on the My Teams
    lists, as a Header Band card like every match. %>
<% if item.is_a?(Friendly) %>
  <% mine = item.spot_for(current_user) %>
  <% fr_url = friendly_url(item) %>
  <% icons = capture do %>
    <%= render "teams/cu_buttons", cal_url: friendly_google_calendar_url(item, share_url: fr_url),
          share_text: friendly_invite_text(item), share_url: fr_url %>
  <% end %>
  <%# Completed once it has ended (times are wall-clock Eastern), not at its start. %>
  <% done = item.over? %>
  <%= render "shared/band_card", date: item.starts_at, time: item.time_label, pill: (done ? "Completed" : "Upcoming"),
        chip: (mine ? "You're in" : nil),
        league: "Friendly", title: item.title.presence || "Friendly",
        note: "#{friendly_signup_status(item)}#{" · lineup ready" if item.lineup?}",
        venue: item.place, venue_tbd: (item.place ? nil : "Place TBD"),
        action_label: (done ? "View results" : (item.lineup? ? "See lineup" : (mine ? "Open" : "Sign up"))), action_url: friendly_path(item),
        href: friendly_path(item), icons: icons, extra_class: "cr-my-week-card-event" %>
<% else %>
  <% venue = nil %>
  <% if item.location.present? %>
    <% ev_name, ev_rest = item.location.split(/,\s*/, 2) %>
    <% venue = Friendly::Place.new(name: ev_name, address: ev_rest) %>
  <% end %>
  <% icons = capture do %>
    <%= render "teams/cu_buttons", cal_url: team_event_google_calendar_url(item), share_text: team_event_share_text(item) %>
  <% end %>
  <%# Calendar entries a captain added as a match read like match cards: the
      team name in the serif, "vs. Opponent" in sans, Home/Away on its own line,
      and the pill flips to Completed once the end time has passed. %>
  <% team = item.tennis_team %>
  <% over = item.over? %>
  <% ev_status = item.playoff? ? "Playoffs" : (over ? "Completed" : "Upcoming") %>
  <% opp = item.match_like? ? item.opponent : nil %>
  <% title = opp ? team.name : LineStartTime.mark_times(item.match_like? ? item.title_without_side : item.title) %>
  <% notes = [] %>
  <% notes << "Needs scores" if over && item.match_like? %>
  <% notes << team.name unless opp %>
  <%= render "shared/band_card", date: item.event_date, time: item.time_label, pill: ev_status,
        league: "#{team.league_label} · #{item.kind_label}", title: title,
        subtitle: (opp ? "vs. #{opp}" : nil),
        teams: (item.match_like? ? item.side : nil),
        note: notes.join(" · ").presence, venue: venue, venue_tbd: (venue ? nil : "Place TBD"),
        action_label: "View team", action_url: team_path(team, tab: "schedule"),
        icons: icons, extra_class: "cr-my-week-card-event" %>
<% end %>
