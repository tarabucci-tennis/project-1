<% content_for :title, "My Teams · Court Report" %>

<div class="cr-home-page">

  <div class="cr-page-header cr-page-header-row">
    <div>
      <h1 class="cr-page-title">My Teams</h1>
      <%# Changes with the tab (home_tabs_controller reads each panel's data-subtitle). %>
      <p class="cr-home-subtitle" id="cr-home-subtitle">How your teams stand, league by league</p>
    </div>
    <div class="cr-page-header-actions">
      <%= link_to "Players & Teams", lookup_path, class: "cr-btn cr-btn-outline cr-btn-compact" %>
      <% if RatingsController::PUBLIC || current_user.admin? %>
        <%= link_to "Ratings", ratings_path, class: "cr-btn cr-btn-outline cr-btn-compact" %>
      <% end %>

      <div class="cr-menu cr-hover-menu" data-controller="menu" data-menu-hover-value="true">
        <button type="button" class="cr-btn cr-btn-gold cr-btn-compact cr-menu-trigger"
                data-action="menu#toggle" data-menu-target="trigger"
                aria-haspopup="true" aria-expanded="false">
          + New Team <span class="cr-menu-caret" aria-hidden="true">▾</span>
        </button>
        <div class="cr-menu-panel" data-menu-target="panel" role="menu">
          <%= link_to new_team_path, class: "cr-menu-item", role: "menuitem" do %>
            Create a team
          <% end %>
          <%= link_to find_team_path, class: "cr-menu-item", role: "menuitem" do %>
            Join a team
          <% end %>
          <%= link_to new_usta_team_path, class: "cr-menu-item", role: "menuitem" do %>
            Add a USTA team (TennisLink file)
          <% end %>
          <% if current_user.admin? %>
            <div class="cr-menu-divider"></div>
            <%= button_to admin_sync_scores_path, method: :post,
                  form: { style: "margin:0;", data: { turbo_confirm: "Update every league now? It runs in the background and takes a few minutes." } },
                  class: "cr-menu-item cr-menu-item-btn", role: "menuitem" do %>
              Sync scores
            <% end %>
            <% if (sync = NightlySyncJob.status) %>
              <% failed = Array(sync[:steps]).reject { |st| st[:ok] } %>
              <div class="cr-menu-note">
                <% if sync[:state] == "running" %>
                  Sync running (started <%= sync[:started_at]&.to_time&.in_time_zone("Eastern Time (US & Canada)")&.strftime("%-l:%M %p") %>)
                <% else %>
                  Last sync <%= sync[:finished_at]&.to_time&.in_time_zone("Eastern Time (US & Canada)")&.strftime("%b %-d, %-l:%M %p") %>
                  · <%= failed.any? ? "failed: #{failed.map { |st| st[:label] }.join(', ')}" : "all OK" %>
                <% end %>
              </div>
            <% end %>
            <%= link_to admin_usta_import_path, class: "cr-menu-item", role: "menuitem" do %>
              Import USTA results
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <% any_teams = @teams_by_league.values.flatten.any? %>

  <% if any_teams %>
    <div data-controller="home-tabs">
      <div class="cr-home-tabs">
        <button class="cr-home-tab cr-home-tab-active" data-home-tabs-target="tab" data-action="click->home-tabs#switch">Standings</button>
        <button class="cr-home-tab" data-home-tabs-target="tab" data-action="click->home-tabs#switch">Calendar</button>
        <button class="cr-home-tab" data-home-tabs-target="tab" data-action="click->home-tabs#switch">Upcoming</button>
        <%# Book a friendly: the one place for friendlies. A mouse hovers to drop down
            the menu (book one, or open / edit an upcoming friendly); a tap on a phone
            opens the same menu. Either way the tab also shows the friendlies panel. %>
        <div class="cr-menu cr-hover-menu cr-fr-menu cr-home-tab-menu" data-controller="menu" data-menu-hover-value="true">
          <button class="cr-home-tab" data-home-tabs-target="tab" data-tab-key="friendlies"
                  data-action="click->home-tabs#switch click->menu#tabTap" aria-haspopup="true">Friendlies</button>
            <div class="cr-menu-panel" data-menu-target="panel" role="menu">
              <%= link_to new_friendly_path(kind: "round_robin"), class: "cr-menu-item", role: "menuitem" do %>
                + Book a round robin
              <% end %>
              <%= link_to new_friendly_path(kind: "friendly"), class: "cr-menu-item", role: "menuitem" do %>
                + Book a friendly
              <% end %>
              <div class="cr-menu-divider"></div>
              <%= link_to friendlies_path, class: "cr-menu-item cr-fr-menu-head", role: "menuitem" do %>
                All friendlies <span aria-hidden="true">→</span>
              <% end %>
              <% menu_friendlies = @upcoming_friendlies.first(8) %>
              <% if menu_friendlies.any? %>
                <% menu_friendlies.each do |f| %>
                  <div class="cr-fr-menu-row">
                    <%= link_to friendly_path(f), class: "cr-menu-item cr-fr-menu-open", role: "menuitem" do %>
                      <span class="cr-fr-menu-when"><%= f.starts_at.strftime("%a %-m/%-d") %> · <%= f.time_label %></span>
                      <span class="cr-fr-menu-name"><%= f.title.presence || f.kind_label %></span>
                    <% end %>
                    <% if f.organizer_id == current_user.id || current_user.admin? %>
                      <%= link_to "Edit", edit_friendly_path(f), class: "cr-fr-menu-edit", role: "menuitem",
                            "aria-label": "Edit #{f.title.presence || 'friendly'}" %>
                    <% end %>
                  </div>
                <% end %>
              <% else %>
                <div class="cr-menu-note cr-fr-menu-empty">No upcoming friendlies yet.</div>
              <% end %>
            </div>
        </div>
      </div>

      <%# ── Panel 1: Standings (the landing view) ───────────────── %>
      <div data-home-tabs-target="panel" data-subtitle="How your teams stand, league by league">
        <div class="cr-standings-wrap">
          <div class="cr-standings-head">
            <span class="cr-standings-head-title">Team Standings</span>
            <span class="cr-standings-head-season">2026 Season</span>
          </div>
          <table class="cr-standings cr-home-st">
            <thead>
              <tr>
                <th class="cr-st-n">#</th>
                <th>Team</th>
                <th class="cr-st-n"><span class="cr-st-dot cr-st-dot-w" title="Wins">W</span></th>
                <th class="cr-st-n"><span class="cr-st-dot cr-st-dot-l" title="Losses">L</span></th>
                <th class="cr-st-n" title="Ties">T</th>
                <th class="cr-st-n">Win%</th>
                <th class="cr-st-last-h">Last</th>
                <th>Next match</th>
              </tr>
            </thead>
            <tbody>
              <%# One section per league (USTA, Del-Tri, Bux-Mont, Cup) — records
                  from different leagues aren't comparable, so each ranks on its own. %>
              <% @teams_by_league.each do |league, league_teams| %>
              <tr class="cr-st-league"><td colspan="8"><%= league %></td></tr>
              <% standings = league_teams.sort_by { |t| [ (t.wins_count + t.losses_count + t.ties_count).positive? ? 0 : 1, -(t.win_pct || 0), -t.wins_count, t.name.to_s.downcase ] } %>
              <% standings.each_with_index do |team, i| %>
                <tr class="cr-st-row" onclick="if (!event.target.closest('a')) window.location='<%= team_path(team) %>'">
                  <td class="cr-st-n cr-st-rank"><span class="cr-st-rank-badge"><%= i + 1 %></span></td>
                  <td>
                    <%= link_to team.name, team_path(team), class: "cr-st-team" %>
                    <div class="cr-st-sub">
                      <%= team.league_label %><% if team.team_type.present? %> · <%= team.team_type %><% end %><% if team.rating.present? %> · <%= team.rating %><% end %>
                    </div>
                  </td>
                  <td class="cr-st-n cr-st-w"><%= team.wins_count %></td>
                  <td class="cr-st-n cr-st-l"><%= team.losses_count %></td>
                  <td class="cr-st-n cr-st-t"><%= team.ties_count %></td>
                  <td class="cr-st-n">
                    <% if team.win_pct %>
                      <span class="<%= team.win_pct >= 50 ? "cr-st-pct-good" : "cr-st-pct-bad" %>"><%= team.win_pct %>%</span>
                    <% else %>—<% end %>
                  </td>
                  <td class="cr-st-last">
                    <% last = team.matches.select(&:played?).max_by(&:match_date) %>
                    <% if last %>
                      <span class="cr-st-last-badge cr-st-last-<%= last.result_label.downcase %>"><%= last.result_label %></span>
                      <span class="cr-st-last-score"><%= last.score_summary %></span>
                      <span class="cr-st-last-opp">vs <%= last.opponent %></span>
                    <% else %>
                      <span class="cr-st-muted">—</span>
                    <% end %>
                  </td>
                  <td class="cr-st-next">
                    <% nm = team.next_match %>
                    <% ne = @next_event_by_team[team.id] %>
                    <% ne = nil if nm && ne && nm.match_date.to_date <= ne.event_date %>
                    <% if ne %>
                      <span class="cr-st-next-date"><%= ne.event_date.strftime("%a %b %-d") %><%= " · #{ne.time_label}" if ne.time_label.present? %></span>
                      <span class="cr-st-next-opp"><% if ne.opponent %>vs <%= ne.opponent %><% else %><%= ne.title_without_side %><% end %><% if ne.side %> · <%= ne.side %><% end %></span>
                    <% elsif nm %>
                      <span class="cr-st-next-date"><%= nm.match_date.strftime("%a %b %-d") %><%= " · #{nm.time_label}" if nm.time_label.present? %></span>
                      <span class="cr-st-next-opp">vs <%= nm.opponent %><% if nm.home? %> · Home<% elsif nm.away? %> · Away<% end %></span>
                    <% elsif team.start_date && team.start_date > PlayClock.today %>
                      <span class="cr-st-muted">Starts <%= team.start_date.strftime("%-m/%-d") %></span>
                    <% elsif team.matches.none? && !@teams_with_events.include?(team.id) %>
                      <span class="cr-st-muted">No schedule yet</span>
                    <% else %>
                      <span class="cr-st-muted">Season complete</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
        <p class="cr-st-hint">Win % counts a tie as half a win: (W + ½T) ÷ matches played. Tap a team to open its full details →</p>
      </div>

      <%# ── Panel 2: Calendar ───────────────────────────────────── %>
      <div data-home-tabs-target="panel" data-subtitle="Your matches, clinics and friendlies by month" style="display: none;">
        <div data-controller="dashboard-calendar"
             data-dashboard-calendar-teams-value='<%= @my_teams.map { |t| { id: t.id, name: t.name, can_manage: (@team_can_manage ||= {})[t.id] ||= (t.can_set_lineup?(current_user) || current_user.admin?) } }.to_json %>'>
          <div class="cr-dash-cal cr-dash-cal-full">
            <div class="cr-dash-cal-header">
              <%= link_to "‹", teams_path(month: @calendar_prev_month, tab: "calendar"), class: "cr-dash-cal-nav", title: "Previous month" %>
              <h3 class="cr-dash-cal-title"><%= @calendar_month.strftime("%B %Y") %></h3>
              <%= link_to "›", teams_path(month: @calendar_next_month, tab: "calendar"), class: "cr-dash-cal-nav", title: "Next month" %>
            </div>
            <%# The colour key sits under the month name, where it's seen first. %>
            <div class="cr-dash-cal-legend cr-dash-cal-legend-top">
              <span><span class="cr-dash-cal-dot cr-dash-cal-dot-match"></span> Match</span>
              <span><span class="cr-dash-cal-dot cr-dash-cal-dot-clinic"></span> Clinic</span>
              <span><span class="cr-dash-cal-dot cr-dash-cal-dot-friendly"></span> Friendly</span>
            </div>

            <div class="cr-dash-cal-weekdays">
              <span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span>
            </div>

            <div class="cr-dash-cal-grid">
              <% @calendar_month.wday.times do %>
                <div class="cr-dash-cal-day cr-dash-cal-day-blank"></div>
              <% end %>

              <% (@calendar_month..@calendar_month.end_of_month).each do |day| %>
                <% matches_today = @calendar_matches_by_day[day] || [] %>
                <% events_today  = @calendar_events_by_day[day]  || [] %>
                <% friendlies_today = @calendar_friendlies_by_day[day] || [] %>
                <% has_items     = matches_today.any? || events_today.any? || friendlies_today.any? %>
                <% is_today      = day == PlayClock.today %>
                <% payload = {
                     date: day.strftime("%Y-%m-%d"),
                     label: day.strftime("%A, %B %-d, %Y"),
                     matches: matches_today.map { |m|
                       { opponent: m.opponent, time: m.time_label, location: m.location, team: m.tennis_team.name, team_url: team_path(m.tennis_team), url: team_match_path(m.tennis_team, m) }
                     },
                     events: events_today.map { |e|
                       { title: LineStartTime.mark_times(e.match_like? ? e.title_without_side : e.title), side: (e.side if e.match_like?), kind: e.display_kind, kind_label: e.kind_label, time: e.time_label, location: e.location, team: e.tennis_team.name, team_url: team_path(e.tennis_team), id: e.id, team_id: e.tennis_team_id }
                     },
                     friendlies: friendlies_today.map { |f|
                       { title: f.title, time: f.time_label, location: f.location,
                         spots: friendly_signup_status(f), url: friendly_path(f) }
                     }
                   }.to_json %>

                <%# Each entry: its time on one line, who/what on the next. %>
                <% chips = matches_today.map { |m| { kind: "match", time: m.time_label, label: m.opponent.presence || "TBD", url: team_match_path(m.tennis_team, m) } } +
                           events_today.map { |e| { kind: e.display_kind, time: e.time_label, label: LineStartTime.mark_times((e.match_like? ? e.title_without_side : e.title).presence || e.kind_label), url: nil } } +
                           friendlies_today.map { |f| { kind: "friendly", time: f.starts_at.strftime("%-l:%M %p"), label: f.title.presence || "Friendly", url: friendly_path(f) } } %>
                <button type="button"
                        class="cr-dash-cal-day <%= 'cr-dash-cal-day-has' if has_items %> <%= 'cr-dash-cal-day-today' if is_today %>"
                        aria-label="<%= day.strftime('%A, %B %-d') %><%= ": #{pluralize(chips.size, 'item')}" if has_items %>"
                        data-action="click->dashboard-calendar#open mouseenter->dashboard-calendar#hoverIn mouseleave->dashboard-calendar#hoverOut"
                        data-dashboard-calendar-payload-param='<%= payload %>'>
                  <span class="cr-dash-cal-day-num"><%= day.day %></span>
                  <% chips.first(3).each do |c| %>
                    <span class="cr-dash-cal-chip cr-dash-cal-chip-<%= c[:kind] %>"<% if c[:url] %> data-url="<%= c[:url] %>"<% end %>><% if c[:time].present? %><span class="cr-dash-cal-chip-time"><%= c[:time] %></span><% end %><span class="cr-dash-cal-chip-text"><%= c[:label] %></span></span>
                  <% end %>
                  <% if chips.size > 3 %>
                    <span class="cr-dash-cal-more">+<%= chips.size - 3 %> more</span>
                  <% end %>
                </button>
              <% end %>
            </div>

            <%# Hover preview (mouse only): the day's schedule; click an item to open it. %>
            <div class="cr-dash-cal-hover" data-dashboard-calendar-target="hover" role="tooltip" hidden
                 data-action="mouseenter->dashboard-calendar#hoverKeep mouseleave->dashboard-calendar#hoverOut">
              <div class="cr-dash-cal-hover-title" data-dashboard-calendar-target="hoverTitle"></div>
              <div class="cr-dash-cal-hover-body" data-dashboard-calendar-target="hoverBody"></div>
            </div>

          </div>

          <div class="cr-cal-sync">
            <%= link_to profile_path(anchor: "my-tennis-calendar"), class: "cr-chip-btn cr-cal-sync-btn" do %>
              🔗 Sync your calendar
            <% end %>
            <span class="cr-cal-sync-note">Pull your own matches, clinics &amp; friendlies from Google Calendar (or any calendar).</span>
          </div>

          <%# Day-detail modal (populated by Stimulus on day click) %>
          <div class="cr-dash-cal-modal"
               data-dashboard-calendar-target="modal"
               data-action="click->dashboard-calendar#closeBackdrop">
            <div class="cr-dash-cal-modal-panel">
              <button type="button" class="cr-dash-cal-modal-close" data-action="click->dashboard-calendar#close" aria-label="Close">&times;</button>
              <h3 class="cr-dash-cal-modal-title" data-dashboard-calendar-target="title"></h3>
              <div class="cr-dash-cal-modal-body" data-dashboard-calendar-target="body"></div>

              <div class="cr-dash-cal-modal-add" data-dashboard-calendar-target="addWrap" style="display: none;">
                <h4 class="cr-dash-cal-modal-add-title">Add to this day</h4>
                <%= form_with url: "#", method: :post,
                              data: { dashboard_calendar_target: "form", action: "submit->dashboard-calendar#submitForm" },
                              local: true, class: "cr-dash-cal-form" do %>
                  <input type="hidden" name="event_date" data-dashboard-calendar-target="formDate">
                  <label class="cr-dash-cal-form-row">
                    <span>Team</span>
                    <select name="team_id" data-dashboard-calendar-target="formTeam" required>
                      <% @my_teams.each do |t| %>
                        <% if t.can_set_lineup?(current_user) || current_user.admin? %>
                          <option value="<%= t.id %>"><%= t.name %></option>
                        <% end %>
                      <% end %>
                    </select>
                  </label>
                  <label class="cr-dash-cal-form-row">
                    <span>Type</span>
                    <select name="kind"
                            onchange="var r = this.form.querySelector('.cr-dash-cal-form-other'); r.hidden = this.value !== 'other'; var i = r.querySelector('input'); i.required = !r.hidden; if (!r.hidden) i.focus()">
                      <option value="friendly">Friendly</option>
                      <option value="clinic">Clinic</option>
                      <option value="other">Something else…</option>
                    </select>
                  </label>
                  <label class="cr-dash-cal-form-row cr-dash-cal-form-other" hidden>
                    <span>What is it?</span>
                    <input type="text" name="kind_other" maxlength="30" placeholder="e.g. Lesson, Tournament, Team dinner">
                  </label>
                  <label class="cr-dash-cal-form-row">
                    <span>Title</span>
                    <input type="text" name="title" placeholder="e.g. Saturday Doubles">
                  </label>
                  <label class="cr-dash-cal-form-row">
                    <span>Time</span>
                    <input type="text" name="start_time" placeholder="e.g. 6:00 PM">
                  </label>
                  <label class="cr-dash-cal-form-row">
                    <span>Location</span>
                    <input type="text" name="location" placeholder="Court or club">
                  </label>
                  <div class="cr-dash-cal-form-actions">
                    <button type="submit" class="cr-btn cr-btn-gold cr-btn-compact">Add</button>
                  </div>
                <% end %>
              </div>

              <p class="cr-dash-cal-modal-captain-note" data-dashboard-calendar-target="captainNote" style="display: none;">
                Only captains and co-captains can add friendlies or clinics here. Anyone can use + Round robin / friendly.
              </p>
            </div>
          </div>
        </div>
      </div>

      <%# ── Panel 3: Coming Up ──────────────────────────────────── %>
      <div data-home-tabs-target="panel" data-subtitle="Everything coming up, soonest first" style="display: none;">
        <% if @coming_up_items.any? %>
          <div class="cr-my-week-list cr-band-grid">
            <% bucket_of = ->(i) { week_bucket(i.is_a?(Match) ? i.match_date : (i.respond_to?(:starts_at) ? i.starts_at : i.event_date)) } %>
            <% bucket_counts = @coming_up_items.map(&bucket_of).tally %>
            <% last_bucket = nil %>
            <% @coming_up_items.each do |match| %>
              <% bucket = bucket_of.call(match) %>
              <% if bucket != last_bucket %>
                <h3 class="cr-week-head"><%= bucket %> <span class="cr-week-head-count"><%= pluralize(bucket_counts[bucket], "game") %></span></h3>
                <% last_bucket = bucket %>
              <% end %>
              <% unless match.is_a?(Match) %>
                <%= render "teams/event_card", item: match %>
                <% next %>
              <% end %>
              <%= render "teams/match_band_card", match: match %>
            <% end %>
          </div>
        <% else %>
          <p class="cr-coming-up-empty">Nothing coming up on any of your teams.</p>
        <% end %>
      </div>

      <%# ── Panel 4: Friendlies only ─────────────────────────────
          Booked friendlies plus captain-added team friendlies. Clinics and
          other calendar events ("League match", "Team dinner") stay on
          Upcoming and Calendar; this tab is blank when there are no friendlies. %>
      <div class="cr-fr-panel" data-home-tabs-target="panel" data-subtitle="Friendlies you've booked or joined" style="display: none;">
        <%# Computers hide the tab bar (the left column replaces it), so the
            Book a friendly menu isn't there: offer the same two links here.
            Phones keep the tab-bar menu and never see this row. %>
        <div class="cr-fr-panel-head">
          <%= link_to "+ Round robin / friendly", new_friendly_path, class: "cr-btn cr-btn-gold" %>
          <%= link_to "All friendlies →", friendlies_path, class: "cr-btn cr-btn-outline" %>
        </div>
        <% fc_items = @upcoming_friendlies.to_a + @upcoming_team_events.select { |e| e.display_kind == "friendly" } %>
        <% fc_items = fc_items.sort_by { |i| i.is_a?(Friendly) ? i.starts_at : i.event_date.in_time_zone } %>
        <% if fc_items.any? %>
          <div class="cr-my-week-list cr-fr-list cr-band-grid">
            <% fc_items.each do |item| %>
              <%= render "teams/event_card", item: item %>
            <% end %>
          </div>
        <% else %>
          <p class="cr-coming-up-empty">No friendlies coming up. Tap + Round robin / friendly to book one and share the link.</p>
        <% end %>

        <%# Past friendlies: one "Look back" menu by date (Tara, Nov 23 2026). %>
        <%= render "friendlies/past_picker", friendlies: @past_friendlies, key: "tab" %>

        <%# Below: who you play with, and how it works. %>
        <div class="cr-fr-more cr-fr-more-two">
          <section class="cr-fr-box">
            <h2 class="cr-fr-box-title">You play friendlies with</h2>
            <% if @friendly_partners.any? %>
              <ul class="cr-fr-partners">
                <% @friendly_partners.each do |name, times| %>
                  <li><span class="cr-fr-partner-name"><%= name %></span><span class="cr-fr-partner-n"><%= pluralize(times, "time") %></span></li>
                <% end %>
              </ul>
            <% else %>
              <p class="cr-fr-box-empty">Once you've played a friendly, the people you play with most show here.</p>
            <% end %>
          </section>

          <section class="cr-fr-box cr-fr-how">
            <h2 class="cr-fr-box-title">How friendlies work</h2>
            <ol class="cr-fr-steps">
              <li><strong>Book it.</strong> Pick a day, time and club with + Round robin / friendly.</li>
              <li><strong>Share the link.</strong> Anyone can add their name, no account needed. Every 4 names fills a court.</li>
              <li><strong>Play.</strong> Court Report mixes up partners for each set and keeps the scores.</li>
            </ol>
          </section>
        </div>
      </div>
    </div>

  <% else %>
    <div class="cr-empty" style="padding: 60px 20px; text-align: center;">
      
      <h2 style="font-size: 1.2rem; margin-bottom: 8px;">You haven't joined any teams yet</h2>
      <p style="color: var(--cr-text-muted); font-size: 0.9rem; margin-bottom: 28px;">
        Find your team, or create a new one.
      </p>
      <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
        <%= link_to "Find a Team", find_team_path, class: "cr-btn cr-btn-gold", style: "padding: 12px 28px; font-size: 0.95rem;" %>
        <%= link_to "Create a Team", new_team_path, class: "cr-btn cr-btn-outline", style: "padding: 12px 28px; font-size: 0.95rem;" %>
      </div>
    </div>
  <% end %>

  <%# ── Past Seasons (archived teams) — collapsed by default so it doesn't
       crowd the page; opens to each league, then each year, then the teams. %>
  <% if @archived_teams.present? %>
    <details class="cr-archive-section">
      <summary class="cr-archive-toggle">Past Seasons (<%= @archived_teams.size %>)</summary>
      <%# League ▸ year ▸ teams: each level opens on a click. %>
      <% TennisTeam.group_by_league(@archived_teams).each do |league, teams| %>
        <details class="cr-archive-league">
          <summary class="cr-archive-league-name"><%= league %> <span class="cr-archive-count">(<%= teams.size %>)</span></summary>
          <% archive_by_year(teams).each do |year, year_teams| %>
            <details class="cr-archive-year">
              <summary class="cr-archive-year-name"><%= year %> <span class="cr-archive-count">(<%= year_teams.size %>)</span></summary>
              <% year_teams.each do |team| %>
                <%= link_to team_path(team), class: "cr-archive-row" do %>
                  <span class="cr-archive-row-season"><%= archive_season_part(team) %></span>
                  <span class="cr-archive-row-name"><%= team.name %></span>
                  <span class="cr-archive-row-record"><%= team.record_label %></span>
                <% end %>
              <% end %>
            </details>
          <% end %>
        </details>
      <% end %>
    </details>
  <% end %>
</div>
