<%# The feedback popup, opened by the floating Feedback pill (shared/_feedback_fab).
    The BETA tag beside the logo that also opened it was removed (Tara, Nov 25 2026).
    Uses the browser's built-in popover (no script). %>
<div id="cr-beta-pop" class="cr-beta-pop" popover>
  <%# Small, in the lower right by the Feedback pill; ✕ closes it (Tara, Nov 24 2026). %>
  <button type="button" class="cr-beta-x" popovertarget="cr-beta-pop" popovertargetaction="hide" aria-label="Close">✕</button>
  <h4 class="cr-beta-pop-title">We're still building 🎾</h4>
  <p>Court Report is in beta. Something missing or not working? Tell us.</p>
  <%= form_with url: feedback_path, method: :post, data: { turbo: false }, class: "cr-beta-form" do %>
    <% unless current_user %>
      <input type="text" name="name" maxlength="80" placeholder="Your name (optional)" autocomplete="name">
    <% end %>
    <textarea name="message" rows="2" maxlength="2000" required placeholder="What's working, what's missing, what broke?"></textarea>
    <label class="cr-beta-anon"><input type="checkbox" name="anonymous" value="1"><span>Send anonymously <small>(your name isn't saved)</small></span></label>
    <div class="cr-beta-form-row">
      <button type="submit" class="cr-btn cr-btn-gold">Send feedback</button>
    </div>
  <% end %>
</div>
