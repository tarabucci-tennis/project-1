<%# Header Band match card (Tara's mockup "C. Header Band", Nov 19 2026) — used for
    every match / friendly / calendar entry card on the site.

      ┌─ green band: Fri, Nov 20 · 9:00 AM ............................ AWAY ─┐
      │ DEL-TRI                                                              │
      │ Legacy 1 vs. Penn Oaks 1        (serif team name, sans "vs." line)   │
      │ [You're on 6D]                  (navy chip, gold text — optional)    │
      │ Club name (bold)                                                     │
      │ street, town (grey)                                                  │
      │ ──────────────────────────────────────────────                       │
      │ ( Set lineup )                                        [cal] [share]  │
      └──────────────────────────────────────────────────────────────────────┘

    Locals: date, time, pill, league, title, subtitle ("vs. …"), chip (e.g. "You're on 6D"),
    note (small grey line, optional), venue (Friendly::Place / Club), venue_tbd,
    action_label, action_url, href, icons, extra_class. %>
<% href = local_assigns[:href] %>
<article class="cr-band-card <%= local_assigns[:extra_class] %>"
         <% if href %>onclick="if (!event.target.closest('a,button')) window.location='<%= href %>'" style="cursor: pointer;"<% end %>>
  <%# Two pills on the band: when (date · time) and the status (Upcoming / Completed / Playoffs). %>
  <header class="cr-band-head">
    <span class="cr-band-when"><%= date.strftime("%a, %b %-d") %><% if local_assigns[:time].present? %> · <%= time %><% end %></span>
    <span class="cr-band-pill"><%= local_assigns[:pill].presence || "Upcoming" %></span>
  </header>
  <div class="cr-band-body">
    <div class="cr-band-league"><%= league %></div>
    <%# Only the team / event name is in the serif; "vs. …" stays in the body sans. %>
    <% main, vs = title.to_s, local_assigns[:subtitle].presence %>
    <% if vs.nil? && (m = main.match(/\A(.+?)\s+(vs\.?\s+.+)\z/i)) %><% main, vs = m[1], m[2] %><% end %>
    <h3 class="cr-band-title"><span class="cr-band-title-main"><%= main %></span><% if vs %> <span class="cr-band-title-vs"><%= vs %></span><% end %></h3>
    <% if local_assigns[:chip].present? %><div><span class="cr-band-chip"><%= chip %></span></div><% end %>
    <% if local_assigns[:teams].present? %><div class="cr-band-teams"><%= teams %></div><% end %>
    <% if local_assigns[:note].present? %><div class="cr-band-note"><%= note %></div><% end %>
    <% if local_assigns[:venue] %>
      <% v = venue %>
      <div class="cr-band-venue">
        <% if v.name.present? %><div class="cr-band-venue-name"><%= v.name %></div><% end %>
        <% lines = v.address_lines %>
        <% if lines.any? %><div class="cr-band-venue-addr"><%= lines.join(", ") %></div><% end %>
      </div>
    <% elsif local_assigns[:venue_tbd].present? %>
      <div class="cr-band-venue"><div class="cr-band-venue-addr"><%= venue_tbd %></div></div>
    <% end %>
    <div class="cr-band-actions">
      <%= link_to action_label, action_url, class: "cr-band-btn", onclick: "event.stopPropagation();" %>
      <%= icons %>
    </div>
  </div>
</article>
